#!/bin/sh
#
# Claim a backlog row: lock → edit QUEUE.md → write the item's frontmatter → commit → unlock,
# as one atomic step.
#
# **The commit is why this is a script and not a rule in a document.** A claim edits QUEUE.md,
# and until something commits that edit it sits dirty in the file both windows share — so the
# next window to close anything commits it for you, under its own message. That is not
# hypothetical: one project's close carried two pending claims exactly that way. Timing
# discipline cannot fix it, because the foreign edit is already in the file before you touch it.
# The only fix is upstream — never leave the claim uncommitted — and a script cannot forget.
#
# Usage:  .claude/backlog/claim <id> [token]
#
# `touches:` stays a hand edit afterwards: only you know what you are about to open, and it must
# be widened the moment the work reaches further than you declared.
#
# **Columns are resolved by header name, never by position.** The table's shape is not a contract:
# it was pared from eight columns to five, and a parser keyed on a fixed index then read every
# row's status as empty and refused every claim — silently, with a message that blamed the row.
# A session's honest reading of that is "the backlog has nothing takeable". So: match the header
# cell by name, work against any column order or count, and make a missing `Status` column a loud
# error rather than a refusal. Ownership is not read from a column at all; it lives in the item's
# `claimed_by:`.
#
# See references/CONCURRENCY.md — 'A claim must be durable the moment it is made'.

set -eu

DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
QUEUE="$DIR/QUEUE.md"
LOCK="$DIR/.lock"

ID="${1:-}"
[ -n "$ID" ] || { echo "usage: claim <id> [token]" >&2; exit 2; }
[ -f "$QUEUE" ] || { echo "no QUEUE.md at $QUEUE" >&2; exit 1; }

TOKEN="${2:-$(head -c2 /dev/urandom | xxd -p)}"

# Warn about anything already dirty in the queue before we add to it. With both windows using
# this script the file should be clean; if it is not, our commit will carry those rows too, so
# say which ones rather than letting it happen silently.
if git -C "$DIR" rev-parse --git-dir >/dev/null 2>&1 && ! git -C "$DIR" diff --quiet -- "$QUEUE"; then
  echo "WARNING: QUEUE.md already has uncommitted changes; this commit will carry them:" >&2
  git -C "$DIR" diff -U0 -- "$QUEUE" | awk '/^[+-]\| / { print "  " $0 }' >&2
fi

# --- lock -------------------------------------------------------------------------------------
mkdir "$LOCK" 2>/dev/null || {
  echo "backlog is locked by: $(cat "$LOCK/held-by" 2>/dev/null || echo unknown)" >&2
  exit 1
}
echo "claim $ID by $TOKEN" > "$LOCK/held-by"
# Release the lock however we leave, so a failed claim never strands the other window.
trap 'rm -rf "$LOCK"' EXIT INT TERM

# --- find the columns by name, under the lock -------------------------------------------------
# Under the lock, so the shape we write to is the shape we read. A pre-pared eight-column table
# and the current five-column one differ only in where `Status` sits; both are claimable.
#
# `ID` is resolved by name too. Resolving one column by name and the other by position would make
# the header comment's promise false in exactly the case nobody tests: the parser would look
# order-independent and still read the wrong cell the day a column moves in front of `ID`.
header="$(awk -F'|' '/^\|/ {
  for (i = 2; i < NF; i++) { v = $i; gsub(/^ +| +$/, "", v); if (v == "ID") { print; exit } }
}' "$QUEUE")"
[ -n "$header" ] || { echo "no table header in $QUEUE — expected a row with an 'ID' cell" >&2; exit 1; }

column_named() {
  printf '%s' "$header" | awk -F'|' -v want="$1" '{
    for (i = 2; i < NF; i++) { v = $i; gsub(/^ +| +$/, "", v); if (v == want) { print i; exit } }
  }'
}

ID_COL="$(column_named ID)"
STATUS_COL="$(column_named Status)"
[ -n "$STATUS_COL" ] || {
  echo "no Status column in the QUEUE.md table — cannot tell a ready row from a blocked one" >&2
  echo "header found: $header" >&2
  exit 1
}

# --- re-read the row under the lock -----------------------------------------------------------
# It may have changed since it was chosen; proceeding on a stale read is the whole race.
row="$(awk -F'|' -v id="$ID" -v c="$ID_COL" '/^\|/ { v = $c; gsub(/^ +| +$/, "", v); if (v == id) { print; exit } }' "$QUEUE")"
[ -n "$row" ] || { echo "no row for $ID in QUEUE.md" >&2; exit 1; }

status="$(printf '%s' "$row" | awk -F'|' -v c="$STATUS_COL" '{ v = $c; gsub(/^ +| +$/, "", v); print v }')"
[ "$status" = "ready" ] || {
  echo "$ID is '$status', not ready — pick another row" >&2
  if [ "$status" = "in-progress" ]; then
    echo "who holds it is the item's claimed_by:, in items/$ID-*.md — not a queue column" >&2
  fi
  exit 1
}

# --- edit the row -----------------------------------------------------------------------------
# The Status cell and nothing else. The token goes in the item's frontmatter, so a legacy table
# that still carries an Owner column keeps whatever is already in it.
tmp="$(mktemp)"
awk -F'|' -v OFS='|' -v id="$ID" -v idc="$ID_COL" -v c="$STATUS_COL" '
  /^\|/ {
    v = $idc; gsub(/^ +| +$/, "", v)
    if (v == id) { $c = " in-progress " }
  }
  { print }
' "$QUEUE" > "$tmp"
mv "$tmp" "$QUEUE"

# --- item frontmatter -------------------------------------------------------------------------
item="$(ls "$DIR/items/$ID-"*.md 2>/dev/null | head -1 || true)"
[ -n "$item" ] || { echo "no item file for $ID" >&2; exit 1; }

now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
tmp="$(mktemp)"
# The two ownership keys are *replaced* where they exist and *added* where they do not. An item
# written before the template carried them has nothing to replace, and a silent skip is the worst
# outcome available: the row says claimed, the script says claimed, and the item file records no
# owner at all — so the "did I mint this token?" test in CONCURRENCY.md has nothing to read.
awk -v tok="$TOKEN" -v now="$now" '
  NR == 1 && /^---$/ { fm = 1; print; next }
  fm && /^---$/      {
    if (!by) { print "claimed_by: \"" tok "\""; added = 1 }
    if (!at) { print "claimed_at: " now;         added = 1 }
    fm = 0
    if (added) print "note: item predated the ownership keys; added them" > "/dev/stderr"
    print; next
  }
  fm && /^claimed_by:/ { print "claimed_by: \"" tok "\""; by = 1; next }
  fm && /^claimed_at:/ { print "claimed_at: " now;         at = 1; next }
  fm && /^status:/     { print "status: in-progress"; next }
  { print }
' "$item" > "$tmp"
mv "$tmp" "$item"

# --- commit, by pathspec, in the same breath as the edit --------------------------------------
# Retry briefly: the other window may hold .git/index.lock mid-commit. Never remove that lock.
if git -C "$DIR" rev-parse --git-dir >/dev/null 2>&1; then
  n=0
  until git -C "$DIR" commit -q -m "Claim $ID [$TOKEN]" -- "$QUEUE" "$item" 2>/dev/null; do
    n=$((n + 1))
    [ "$n" -lt 30 ] || { echo "could not commit the claim (git busy); QUEUE.md is edited but uncommitted" >&2; exit 1; }
  done
fi

echo "claimed $ID with token $TOKEN"
echo "now set touches: in $item before you open anything"
