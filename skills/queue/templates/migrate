#!/bin/sh
#
# Move a legacy `.claude/backlog/` or `.backlog/` to `.tickets/` at the repo root, as one commit
# (0182 FR3, 0228 FR2).
#
# **Why it exists.** The harness refuses writes under any `.claude` path segment as a "sensitive
# file", so every stage writing a backlog under `.claude/` improvised a route around the refusal
# while holding the lock. Moving the directory removes the cause instead of naming more fallbacks
# (references/CONCURRENCY.md, *Where the backlog lives*). `.backlog/` was 0182's name for the new
# location until 0228 named it `.tickets/`, for the whole ticket system it holds, so it is legacy too.
#
# Usage:  <legacy backlog>/migrate [token]
#
# **It is a change that touches every file**, so it runs only when nothing else is held
# (references/CONCURRENCY.md, *A change that touches every file takes an exclusive claim*). It
# refuses, naming the cause and changing nothing, when: the lock is held; a row is claimed by a
# token other than the one given; a sprint `runs/.active/` marker is present; `.tickets/` already
# exists; or the backlog holds uncommitted changes, which the move's commit would carry off. A token
# on a `done`, `withdrawn` or `rejected` item is not a claim: `close` leaves `claimed_by:` set on the
# item it closes, and counting those refused one repo's move over 21 closed items (0228).
#
# Otherwise it takes the lock, `git mv`s the tree, rewrites the root `.gitignore` entries naming
# the legacy location, commits the renames and that `.gitignore` change as ONE pathspec commit, and
# releases the lock at its new path. Run again from `.tickets/` it says the repo is already
# migrated and exits 0.
#
# **Install the release carrying this script on every machine that works the repo first.** A skill
# installed before it does not look at `.tickets/`, so on a migrated repo it finds no backlog;
# `tools/release verify` is the check.

set -eu

DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
TOKEN="${1:-}"
COAUTHOR="Co-Authored-By: Claude <noreply@anthropic.com>"

case "$DIR" in
  */.tickets)
    echo "already migrated: the backlog is at $DIR"
    exit 0 ;;
  */.claude/backlog) ROOT="$(CDPATH= cd -- "$DIR/../.." && pwd)"; FROM=.claude/backlog ;;
  */.backlog)        ROOT="$(CDPATH= cd -- "$DIR/.." && pwd)"; FROM=.backlog ;;
  *)
    echo "refusing to migrate: $DIR is none of .claude/backlog/, .backlog/ or .tickets/" >&2
    exit 1 ;;
esac

refuse() { echo "refusing to migrate: $1 -- nothing was changed" >&2; exit 1; }

[ ! -e "$ROOT/.tickets" ] || refuse "$ROOT/.tickets already exists"
[ ! -d "$DIR/.lock" ] || refuse "the lock is held ($(cat "$DIR/.lock/held-by" 2>/dev/null || echo 'no held-by'))"
[ ! -d "$DIR/runs/.active" ] || refuse "a sprint marker is present at runs/.active ($(cat "$DIR/runs/.active/held-by" 2>/dev/null || echo 'no held-by'))"
git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1 || refuse "$ROOT is not a git repository"
[ -z "$(git -C "$ROOT" status --porcelain -- "$FROM")" ] || refuse "the backlog holds uncommitted changes the move would carry"

foreign=""
for item in "$DIR"/items/*.md; do
  [ -f "$item" ] || continue
  held="$(awk '
    NR == 1 && /^---$/ { fm = 1; next }
    fm && /^---$/ { exit }
    fm && /^status:/ { st = $2 }
    fm && /^claimed_by:/ { v = $0; sub(/^claimed_by:[ \t]*/, "", v); gsub(/["\047 \t]/, "", v) }
    END { if (st != "done" && st != "withdrawn" && st != "rejected") print v }
  ' "$item")"
  [ -n "$held" ] && [ "$held" != "$TOKEN" ] && foreign="$foreign $(basename "$item" .md) [$held]"
done
[ -z "$foreign" ] || refuse "a row is claimed by another token:$foreign"

mkdir "$DIR/.lock" 2>/dev/null || refuse "the lock was taken while checking"
printf 'migrate by %s %s\n' "${TOKEN:-none}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$DIR/.lock/held-by"

git -C "$ROOT" mv "$FROM" .tickets
paths="$FROM .tickets"
# The `(^|/)` anchor keeps `.backlog/` from matching inside some other name; `.claude/backlog/`
# cannot match it, since the character before its `backlog` is a slash, not a dot.
if [ -f "$ROOT/.gitignore" ] && grep -qE '\.claude/backlog/|(^|/)\.backlog/' "$ROOT/.gitignore"; then
  sed -E -e 's#\.claude/backlog/#.tickets/#g' -e 's#(^|/)\.backlog/#\1.tickets/#g' "$ROOT/.gitignore" > "$ROOT/.gitignore.migrate"
  mv "$ROOT/.gitignore.migrate" "$ROOT/.gitignore"
  paths="$paths .gitignore"
fi
# shellcheck disable=SC2086  # $paths is a fixed list of three words, split on purpose.
git -C "$ROOT" commit -q -m "Move the backlog to .tickets/

$COAUTHOR" -- $paths
rm -rf "$ROOT/.tickets/.lock"
echo "migrated: $ROOT/$FROM -> $ROOT/.tickets ($(git -C "$ROOT" rev-parse --short HEAD))"
