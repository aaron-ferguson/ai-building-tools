#!/bin/sh
#
# Drain one FINDINGS.md entry: refuse bad input → lock → re-read the listing → remove the entry, mark
# it in place, or move it to FINDINGS-HELD.md → commit → unlock, as one step (0242 FR10).
#
# Usage:  .tickets/drain <date> <removed|marked:<row-id>|held> [<row-id>] [--line <n>]
#         .tickets/drain --help
#
# **What this replaces** is the by-hand drain retro Step 4 and queue Step 5 describe: a sweeper
# finding entries with the regex the buffer's header gives, then editing the file under a by-hand
# lock. That regex matches the header's own fenced example too, so a drain by it removed the example
# from this repo's buffer (0227).
#
# **The entry is the one `./next --findings-list` names**, never a match over the file. The listing
# is `count_findings`'s own run, so the header above the `---` rule is never a candidate, and the
# entry is addressed by the line number the listing prints. A `<date>` naming one entry is enough;
# naming several refuses and lists them, and `--line <n>` (from the listing) picks one. An entry is
# its listed line plus every following line that begins with a space or a tab.
#
# **The dispositions** (retro Step 4, *Held*; FINDINGS.md's header, the head token):
#   - removed            the entry's lines are deleted;
#   - marked:<row-id>    `[-><row-id>]` is written directly after the date, replacing any head token
#                        already there; `marked <row-id>` is the same; `<row-id>` is a four-digit id
#                        with an item file, or `none`;
#   - held               the entry's lines are appended unchanged to FINDINGS-HELD.md, created when
#                        absent, and removed from FINDINGS.md — both in one commit.
#
# **Which disposition an entry gets is the caller's judgement** (0242, *What stays out of the
# scripts*).
#
# **It refuses rather than guesses**, changing nothing and leaving no lock: a date or disposition it
# cannot parse; a mark naming no item; a date or `--line` the listing does not name; a date naming
# several entries without `--line`; FINDINGS.md or FINDINGS-HELD.md uncommitted; a linked worktree; a
# branch other than the shared one. A busy lock is retried for BACKLOG_LOCK_TRIES seconds (default
# 10), then refused — never broken.
#
# See references/CONCURRENCY.md — 'Lock every write to the backlog directory'.

set -eu

DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

# --- where the backlog lives (0182) -- byte-identical in claim, close, handoff, next and reopen ---
# `.tickets/` at the repo root is the location (0228). `.claude/backlog/` and `.backlog/` are legacy:
# the harness refuses writes under any `.claude` path segment as a sensitive file, which is what 0182
# moved away from, and `.backlog/` was the name 0182 chose before 0228 named the directory for the
# whole ticket system it holds. A repo holding more than one is refused rather than guessed at.
# LEGACY_UNTIL is the date in references/CONCURRENCY.md, *Where the backlog lives*, and
# tests/backlog-location.test.sh holds the two equal. The note is exported so a nested call (`close`
# runs `next`) does not print it twice.
LEGACY_UNTIL=2026-12-31
case "$DIR" in
  */.claude/backlog) ROOT="$(CDPATH= cd -- "$DIR/../.." && pwd)"; LEGACY_AT=.claude/backlog ;;
  */.backlog)        ROOT="$(CDPATH= cd -- "$DIR/.." && pwd)"; LEGACY_AT=.backlog ;;
  *)                 ROOT="$(CDPATH= cd -- "$DIR/.." && pwd)"; LEGACY_AT="" ;;
esac
HELD_AT=""
HELD_COUNT=0
for held_loc in .tickets .backlog .claude/backlog; do
  if [ -d "$ROOT/$held_loc" ]; then HELD_AT="$HELD_AT $ROOT/$held_loc"; HELD_COUNT=$((HELD_COUNT + 1)); fi
done
if [ "$HELD_COUNT" -gt 1 ]; then
  echo "refusing: this repo holds more than one backlog:$HELD_AT -- keep one (references/CONCURRENCY.md, Where the backlog lives)" >&2
  exit 1
fi
if [ -n "$LEGACY_AT" ] && [ -z "${BACKLOG_LEGACY_NOTED:-}" ]; then
  echo "note: this backlog is at the legacy $LEGACY_AT/ -- run ./migrate to move it to .tickets/; the legacy location works until $LEGACY_UNTIL" >&2
  BACKLOG_LEGACY_NOTED=1
  export BACKLOG_LEGACY_NOTED
fi
# --- end of where the backlog lives ---
FINDINGS="$DIR/FINDINGS.md"
HELDBUF="$DIR/FINDINGS-HELD.md"
LOCK="$DIR/.lock"

# The generic trailer, for `handoff`'s reason: the script cannot know which model is driving it.
COAUTHOR="Co-Authored-By: Claude <noreply@anthropic.com>"

drain_usage() {
  echo "usage: drain <date> <removed|marked:<row-id>|held> [<row-id>] [--line <n>]"
  echo "  date             the entry's YYYY-MM-DD, as ./next --findings-list prints it"
  echo "  removed          delete the entry"
  echo "  marked:<row-id>  write [-><row-id>] after its date; <row-id> is an item's id, or none;"
  echo "                   'marked <row-id>' is the same"
  echo "  held             move it, unchanged, to FINDINGS-HELD.md"
  echo "  --line <n>       which entry, by the line ./next --findings-list prints, when the date"
  echo "                   names more than one"
}

case "${1:-}" in
  -h|--help) drain_usage; exit 0 ;;
  ""|-*) drain_usage >&2; exit 2 ;;
esac
[ $# -ge 2 ] || { drain_usage >&2; exit 2; }
DATE="$1"; DISP="$2"; shift 2
ROWID=""
LINE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --line) [ $# -ge 2 ] && [ -n "$2" ] || { drain_usage >&2; exit 2; }; LINE="$2"; shift 2 ;;
    -*) echo "refusing to drain: unknown argument '$1'" >&2; drain_usage >&2; exit 2 ;;
    *) [ -z "$ROWID" ] || { echo "refusing to drain: unexpected argument '$1'" >&2; drain_usage >&2; exit 2; }
       ROWID="$1"; shift ;;
  esac
done
VERB=drain
ID="the $DATE entry"

# --- refuse malformed input before the lock (FR3) ------------------------------------------------
drain_refuse() { echo "refusing to $VERB $ID: $1" >&2; echo "nothing was changed and no lock was taken" >&2; exit 1; }

case "$DATE" in
  [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) : ;;
  *) drain_refuse "'$DATE' is not a YYYY-MM-DD date" ;;
esac
MARK=""
case "$DISP" in
  removed|held)
    [ -z "$ROWID" ] || drain_refuse "a row id goes with marked only, and '$DISP' was given '$ROWID'" ;;
  marked:*)
    [ -z "$ROWID" ] || drain_refuse "the row id is given twice: '$DISP' and '$ROWID'"
    MARK="${DISP#marked:}"; DISP=marked ;;
  marked)
    MARK="$ROWID" ;;
  *) drain_refuse "unknown disposition '$DISP' — one of removed, marked:<row-id>, held" ;;
esac
if [ "$DISP" = marked ]; then
  case "$MARK" in
    none) : ;;
    [0-9][0-9][0-9][0-9])
      [ -n "$(ls "$DIR/items/$MARK-"*.md 2>/dev/null | head -1)" ] || drain_refuse "no item file for $MARK; a mark names the row now carrying the entry" ;;
    *) drain_refuse "'$MARK' is not a four-digit row id or none" ;;
  esac
fi
if [ -n "$LINE" ]; then
  case "$LINE" in *[!0-9]*) drain_refuse "--line '$LINE' is not a line number" ;; esac
fi
[ -f "$FINDINGS" ] || drain_refuse "there is no FINDINGS.md at $FINDINGS"
[ -x "$DIR/next" ] || drain_refuse "there is no ./next beside it, and the entry is the one its --findings-list names"

# --- the linked-worktree refusal (0083) --------------------------------------------------------
# The lock, QUEUE.md and the items live in the working tree, so a linked worktree's copies are ones
# no other session reads (CONCURRENCY.md, 'A second checkout never writes the backlog').
if git -C "$DIR" rev-parse --git-dir >/dev/null 2>&1 &&
   [ "$(git -C "$DIR" rev-parse --path-format=absolute --git-dir)" != \
     "$(git -C "$DIR" rev-parse --path-format=absolute --git-common-dir)" ]; then
  echo "refusing to $VERB $ID: this is a linked worktree, whose lock and QUEUE.md no other session reads" >&2
  echo "run it from the primary checkout: $(git -C "$DIR" worktree list --porcelain | sed -n '1s/^worktree //p')" >&2
  echo "nothing was changed and no lock was taken" >&2
  exit 1
fi

# copy-begin: shared-branch
# The backlog is written on one branch (0235, 0242 S7). A claim committed on any other branch is
# invisible to every session reading the shared one, so the single-holder guarantee stops at the
# branch: a `prototype/` session once claimed, decided and handed off a row that `main` still read
# as unclaimed. Refuse, never warn, and up front — directly after the linked-worktree refusal,
# before the lock and before any file is read for writing — so the session learns it at `./claim`,
# before it has spent anything on the row. A detached HEAD is off the branch. Outside a git work
# tree the check does not apply. No flag overrides it: the `shared_branch:` key is the one way to
# name another branch. Resolved first hit wins, and nothing fetches:
#   1. `shared_branch:` in this directory's config.yml, comment and blanks stripped (empty = unset)
#   2. `git symbolic-ref --short refs/remotes/origin/HEAD`, its `origin/` removed
#   3. `main`
# See `CONCURRENCY.md`, *The backlog is written on one branch*. $1 is the script's own verb.
refuse_off_shared_branch() {
  git -C "$DIR" rev-parse --git-dir >/dev/null 2>&1 || return 0
  sb=""
  if [ -f "$DIR/config.yml" ]; then
    sb="$(awk '/^shared_branch:/ {
      v = $0; sub(/^shared_branch:/, "", v); sub(/#.*/, "", v); gsub(/[ \t]/, "", v)
      print v; exit
    }' "$DIR/config.yml")"
  fi
  if [ -z "$sb" ] && sb="$(git -C "$DIR" symbolic-ref --short -q refs/remotes/origin/HEAD 2>/dev/null)"; then
    sb="${sb#origin/}"
  fi
  [ -n "$sb" ] || sb="main"
  cur="$(git -C "$DIR" symbolic-ref --short -q HEAD 2>/dev/null)" || cur=""
  [ -n "$cur" ] || cur="HEAD (detached)"
  [ "$cur" != "$sb" ] || return 0
  cfg="$(git -C "$DIR" rev-parse --show-prefix 2>/dev/null || true)config.yml"
  echo "refusing to $1 $ID: this checkout is on '$cur', and the backlog is shared on '$sb'" >&2
  echo "switch with: git switch $sb, or set shared_branch: in $cfg if '$sb' is wrong" >&2
  echo "see references/CONCURRENCY.md, 'The backlog is written on one branch'" >&2
  echo "nothing was changed and no lock was taken" >&2
  exit 1
}
# copy-end: shared-branch
refuse_off_shared_branch "$VERB"

git -C "$DIR" rev-parse --git-dir >/dev/null 2>&1 || {
  echo "refusing to $VERB $ID: $DIR is not in a git repository, and a backlog write is a commit" >&2
  echo "nothing was changed and no lock was taken" >&2
  exit 1
}

# Anything already changed in a file this commit names would ride along on it, and a pathspec limits
# a commit to paths, never to authorship — CONCURRENCY.md, 'A pathspec is necessary but not
# sufficient'. Staged or not, so against HEAD; an untracked held file is someone else's write too.
HELD_TRACKED=""
! git -C "$DIR" ls-files --error-unmatch -- FINDINGS-HELD.md >/dev/null 2>&1 || HELD_TRACKED=1
drain_dirty() { # drain_dirty <when> — refuses if a buffer this drain writes differs from HEAD
  dirty="$(git -C "$DIR" diff --name-only HEAD -- FINDINGS.md 2>/dev/null || true)"
  if [ "$DISP" = held ]; then
    if [ -n "$HELD_TRACKED" ]; then
      dirty="$dirty $(git -C "$DIR" diff --name-only HEAD -- FINDINGS-HELD.md 2>/dev/null || true)"
    elif [ -e "$HELDBUF" ]; then
      dirty="$dirty FINDINGS-HELD.md (untracked)"
    fi
  fi
  [ -n "$(printf '%s' "$dirty" | tr -d ' ')" ] || return 0
  echo "refusing to $VERB $ID: $(printf '%s' "$dirty" | tr '\n' ' ') holds uncommitted changes this commit would carry" >&2
  echo "commit them by pathspec if they are yours; if they are another session's, leave them alone and wait" >&2
  echo "nothing was changed and $1" >&2
  exit 1
}
drain_dirty "no lock was taken"

# --- the entry, from the listing ------------------------------------------------------------------
# `<buffer>:<line>  <first line>` for this backlog's FINDINGS.md only, its date as the key. MALFORMED
# lines are never candidates; the listing exits non-zero over one, which is not a reason to refuse.
drain_pick() { # prints the one line number this drain acts on, or refuses via $1
  listing="$("$DIR/next" --findings-list 2>/dev/null || true)"
  hits="$(printf '%s\n' "$listing" | awk -v buf="$FINDINGS:" -v d="$DATE" '
    index($0, buf) != 1 { next }
    {
      rest = substr($0, length(buf) + 1)
      n = rest; sub(/ .*/, "", n)
      e = rest; sub(/^[0-9]+  /, "", e); sub(/^- (\*\*)?/, "", e)
      if (substr(e, 1, 10) == d) print n "\t" rest
    }
  ')"
  count="$(printf '%s' "$hits" | awk 'NF { c++ } END { print c + 0 }')"
  if [ -n "$LINE" ]; then
    printf '%s\n' "$hits" | awk -F'\t' -v l="$LINE" '$1 == l { f = 1 } END { exit !f }' ||
      "$1" "line $LINE is not a findings entry dated $DATE in ./next --findings-list"
    printf '%s\n' "$LINE"
    return 0
  fi
  [ "$count" -gt 0 ] || "$1" "no findings entry dated $DATE in ./next --findings-list (the header above the --- rule is never one)"
  [ "$count" -eq 1 ] || "$1" "$count findings entries are dated $DATE; pick one with --line <n>:
$(printf '%s\n' "$hits" | cut -f2)"
  printf '%s\n' "$hits" | cut -f1
}
drain_pick drain_refuse >/dev/null

# --- lock, retried while busy, never broken (FR1) ----------------------------------------------
tries="${BACKLOG_LOCK_TRIES:-10}"
until mkdir "$LOCK" 2>/dev/null; do
  tries=$((tries - 1))
  [ "$tries" -gt 0 ] || {
    echo "backlog is locked by: $(cat "$LOCK/held-by" 2>/dev/null || echo unknown)" >&2
    echo "nothing was changed; the lock is another session's, so it was left alone" >&2
    exit 1
  }
  sleep 1
done
printf '%s %s\n%s\n' "$VERB" "$DATE" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$LOCK/held-by"
TMPD=""
drain_cleanup() {
  [ -z "$TMPD" ] || rm -rf "$TMPD"
  rm -rf "$LOCK"
}
trap drain_cleanup EXIT INT TERM
TMPD="$(mktemp -d)"
drain_locked_refuse() { echo "refusing to $VERB $ID: $1" >&2; echo "nothing was changed and the lock is released" >&2; exit 1; }

# --- re-read under the lock ----------------------------------------------------------------------
drain_dirty "the lock is released"
AT="$(drain_pick drain_locked_refuse)"
case "$AT" in ""|*[!0-9]*) drain_locked_refuse "the listing named no single line" ;; esac

# The entry's extent: its listed line, and every following line beginning with a space or a tab.
END_AT="$(awk -v at="$AT" '
  NR == at { e = NR; next }
  NR > at && e == NR - 1 && /^[ \t]/ { e = NR; next }
  NR > at && e { exit }
  END { print e + 0 }
' "$FINDINGS")"
[ "$END_AT" -ge "$AT" ] || drain_locked_refuse "line $AT is past the end of FINDINGS.md"
awk -v s="$AT" -v e="$END_AT" 'NR >= s && NR <= e' "$FINDINGS" > "$TMPD/entry"

buf_tmp="$TMPD/FINDINGS.md"
case "$DISP" in
  removed|held)
    awk -v s="$AT" -v e="$END_AT" 'NR < s || NR > e' "$FINDINGS" > "$buf_tmp" ;;
  marked)
    awk -v at="$AT" -v tok="[->$MARK]" '
      NR != at { print; next }
      {
        lead = $0; sub(/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9].*/, "", lead)
        rest = substr($0, length(lead) + 11)
        sub(/^ \[->[^]]*\]/, "", rest)
        print lead substr($0, length(lead) + 1, 10) " " tok rest
      }
    ' "$FINDINGS" > "$buf_tmp" ;;
esac
if [ "$DISP" = held ]; then
  held_tmp="$TMPD/FINDINGS-HELD.md"
  if [ -f "$HELDBUF" ]; then
    cat "$HELDBUF" > "$held_tmp"
    # A held file not ending in a newline would join the entry onto its last line.
    [ ! -s "$held_tmp" ] || [ "$(tail -c1 "$held_tmp" | od -An -c | tr -d ' ')" = '\n' ] || printf '\n' >> "$held_tmp"
  else
    printf "# Findings held — real work, not yet confirmed (retro Step 4)\n\n" > "$held_tmp"
  fi
  cat "$TMPD/entry" >> "$held_tmp"
fi

# --- read the result back before anything moves (handoff's 0087 lesson) ------------------------
# The preamble down to the `---` rule is byte-identical, and the entry left, moved or marked as asked.
preamble() { awk '{ print } /^---$/ { exit }' "$1"; }
unapplied=""
[ "$(preamble "$FINDINGS" | cksum)" = "$(preamble "$buf_tmp" | cksum)" ] || unapplied="$unapplied header"
old_n="$(wc -l < "$FINDINGS" | tr -d ' ')"; new_n="$(wc -l < "$buf_tmp" | tr -d ' ')"
case "$DISP" in
  removed|held) [ "$new_n" -eq $((old_n - (END_AT - AT + 1))) ] || unapplied="$unapplied FINDINGS.md.lines" ;;
  marked)
    [ "$new_n" -eq "$old_n" ] || unapplied="$unapplied FINDINGS.md.lines"
    sed -n "${AT}p" "$buf_tmp" | grep -qF -- "$DATE [->$MARK]" || unapplied="$unapplied mark" ;;
esac
if [ "$DISP" = held ]; then
  [ "$(tail -n "$((END_AT - AT + 1))" "$held_tmp" | cksum)" = "$(cksum < "$TMPD/entry")" ] || unapplied="$unapplied FINDINGS-HELD.md"
fi
[ -z "$unapplied" ] || { echo "the drain did not apply to:$unapplied — nothing has been written" >&2; exit 1; }

# --- move into place, then commit by pathspec in the same breath -------------------------------
cp "$FINDINGS" "$TMPD/bak.FINDINGS"
[ ! -f "$HELDBUF" ] || cp "$HELDBUF" "$TMPD/bak.HELD"
drain_restore() {
  cat "$TMPD/bak.FINDINGS" > "$FINDINGS"
  if [ -f "$TMPD/bak.HELD" ]; then cat "$TMPD/bak.HELD" > "$HELDBUF"
  elif [ "$DISP" = held ]; then
    git -C "$DIR" rm -q --cached -- FINDINGS-HELD.md >/dev/null 2>&1 || true
    rm -f "$HELDBUF"
  fi
}
cat "$buf_tmp" > "$FINDINGS"
paths="FINDINGS.md"
if [ "$DISP" = held ]; then
  cat "$held_tmp" > "$HELDBUF"
  paths="$paths FINDINGS-HELD.md"
  # A path git has never seen cannot be committed by pathspec until it is added; add only that path.
  [ -n "$HELD_TRACKED" ] || git -C "$DIR" add -- FINDINGS-HELD.md || { drain_restore; echo "could not add FINDINGS-HELD.md — nothing was kept" >&2; exit 1; }
fi
first="$(head -1 "$TMPD/entry" | cut -c1-120)"
case "$DISP" in
  removed) msg="Drain finding $DATE: removed" ;;
  marked)  msg="Drain finding $DATE: marked [->$MARK]" ;;
  held)    msg="Drain finding $DATE: held" ;;
esac
# Retry briefly: the other window may hold .git/index.lock mid-commit. Never remove that lock.
n=0
# shellcheck disable=SC2086
until git -C "$DIR" commit -q -m "$msg" -m "$first" -m "$COAUTHOR" -- $paths 2>/dev/null; do
  n=$((n + 1))
  [ "$n" -lt 30 ] || { drain_restore; echo "could not commit (git busy) — nothing was kept" >&2; exit 1; }
done

case "$DISP" in
  removed) echo "removed the $DATE entry at FINDINGS.md:$AT" ;;
  marked)  echo "marked the $DATE entry at FINDINGS.md:$AT [->$MARK]" ;;
  held)    echo "moved the $DATE entry at FINDINGS.md:$AT to FINDINGS-HELD.md" ;;
esac
