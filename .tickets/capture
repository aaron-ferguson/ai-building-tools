#!/bin/sh
#
# Capture a ticket into the backlog: refuse a bad draft → lock → mint the id from the disk → write
# the item → stamp ac_digest → correct next_id → insert the row → append the ranking → commit →
# unlock, as one step (0242 FR5). `--restamp` re-stamps an existing item's ac_digest (FR9).
#
# Usage:  .tickets/capture <draft> <top|above:<row-id>|below:<row-id>> [--ranking <file>]
#         .tickets/capture --restamp <id>
#         .tickets/capture --help
#
# **What this replaces** is queue Step 2's Add, made by hand: mint the id, bump `next_id`, write the
# item, insert the row with an Edit, stamp `ac_digest:` from `./next --ac-digest`, append to
# RANKING.md, `git add -N`, commit by pathspec, release the lock — eight tool calls for two tickets
# on 2026-11-26, the first of which died with the lock already taken (0242 Problem).
#
# **Every judgement stays with the caller.** The draft is the ticket as the session wrote it, the
# position is the rank the session chose, and `--ranking` is its reasoning. This script decides
# none of them; it does only the mechanics (0242, *What stays out of the scripts*).
#
# The draft is a whole item file: frontmatter opening on line 1 with `title:`, `next:` and
# `status:`, and at least a `- [ ] AC1 —` criterion. Its `id:` is overwritten with the minted id and
# any `ac_digest:` it carries is replaced, so a draft copied from `templates/item.md` with `id:
# "NNNN"` is the normal input. The id is `max(items on disk) + 1` and `next_id` is corrected to
# match — the counter is a cache and drifts (queue Step 2, *Mint from the disk*). The stamp is
# computed by `./next --ac-digest` over the item AFTER it is written under its id, so the two can
# never disagree. The id is the last line printed, so `id="$(./capture … | tail -1)"` works.
#
# `--restamp <id>` is the Re-specify and Amend path: the session has edited an unclaimed item's
# criteria, and this re-stamps `ac_digest:` from them and commits the item — its edits included,
# which is the point. It refuses a claimed item: a held ticket's contract belongs to its holder.
#
# **It refuses rather than guesses**, changing nothing and leaving no lock: a draft with no AC1, no
# title or an unknown next:/status:; a title holding `|`; a position it cannot parse or an anchor
# that is no row; QUEUE.md, config.yml or RANKING.md uncommitted; a linked worktree; a branch other
# than the shared one. A busy lock is retried for BACKLOG_LOCK_TRIES seconds (default 10), then
# refused — never broken.
#
# See references/CONCURRENCY.md — 'Lock every write to the backlog directory'.

set -eu

DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

# --- where the backlog lives (0182) -- byte-identical in claim, close, handoff, next and reopen ---
# `.tickets/` at the repo root is the location (0228). `.claude/backlog/` and `.backlog/` are legacy:
# the harness refuses writes under any `.claude` path segment as a sensitive file, which is what 0182
# moved away from, and `.backlog/` was the name 0182 chose before 0228 named the directory for the
# whole ticket system it holds. A repo holding more than one is refused rather than guessed at.
# LEGACY_UNTIL is the date in references/CONCURRENCY.md, *Where the backlog lives*, and
# tests/backlog-location.test.sh holds the two equal. The note is exported so a nested call (`close`
# runs `next`) does not print it twice.
LEGACY_UNTIL=2026-12-31
case "$DIR" in
  */.claude/backlog) ROOT="$(CDPATH= cd -- "$DIR/../.." && pwd)"; LEGACY_AT=.claude/backlog ;;
  */.backlog)        ROOT="$(CDPATH= cd -- "$DIR/.." && pwd)"; LEGACY_AT=.backlog ;;
  *)                 ROOT="$(CDPATH= cd -- "$DIR/.." && pwd)"; LEGACY_AT="" ;;
esac
HELD_AT=""
HELD_COUNT=0
for held_loc in .tickets .backlog .claude/backlog; do
  if [ -d "$ROOT/$held_loc" ]; then HELD_AT="$HELD_AT $ROOT/$held_loc"; HELD_COUNT=$((HELD_COUNT + 1)); fi
done
if [ "$HELD_COUNT" -gt 1 ]; then
  echo "refusing: this repo holds more than one backlog:$HELD_AT -- keep one (references/CONCURRENCY.md, Where the backlog lives)" >&2
  exit 1
fi
if [ -n "$LEGACY_AT" ] && [ -z "${BACKLOG_LEGACY_NOTED:-}" ]; then
  echo "note: this backlog is at the legacy $LEGACY_AT/ -- run ./migrate to move it to .tickets/; the legacy location works until $LEGACY_UNTIL" >&2
  BACKLOG_LEGACY_NOTED=1
  export BACKLOG_LEGACY_NOTED
fi
# --- end of where the backlog lives ---
QUEUE="$DIR/QUEUE.md"
CONFIG="$DIR/config.yml"
RANKING="$DIR/RANKING.md"
LOCK="$DIR/.lock"

# The generic trailer, for `handoff`'s reason: the script cannot know which model is driving it.
COAUTHOR="Co-Authored-By: Claude <noreply@anthropic.com>"

capture_usage() {
  echo "usage: capture <draft> <top|above:<row-id>|below:<row-id>> [--ranking <file>]"
  echo "       capture --restamp <id>"
  echo "  draft      a whole item file; its id: is replaced by the minted one, and it needs title:,"
  echo "             next:, status: and a '- [ ] AC1 —' line"
  echo "  position   where the row goes in QUEUE.md — a queue judgement, so never defaulted"
  echo "  --ranking  a file whose text is appended to RANKING.md: why the row sits there"
  echo "  --restamp  re-stamp ac_digest: on an unclaimed item from its criteria now, and commit it"
  echo "prints the new id as its last line"
}

MODE=capture
DRAFT=""
POSITION=""
RANKFILE=""
case "${1:-}" in
  -h|--help) capture_usage; exit 0 ;;
  --restamp)
    MODE=restamp
    [ $# -eq 2 ] && [ -n "$2" ] || { capture_usage >&2; exit 2; }
    ID="$2"
    case "$ID" in
      [0-9][0-9][0-9][0-9]) : ;;
      *) echo "refusing to restamp: '$ID' is not a four-digit id" >&2; exit 2 ;;
    esac
    ;;
  ""|-*) capture_usage >&2; exit 2 ;;
  *)
    [ $# -ge 2 ] || { capture_usage >&2; exit 2; }
    DRAFT="$1"; POSITION="$2"; shift 2
    while [ $# -gt 0 ]; do
      case "$1" in
        --ranking) [ $# -ge 2 ] && [ -n "$2" ] || { capture_usage >&2; exit 2; }; RANKFILE="$2"; shift 2 ;;
        *) echo "refusing to capture: unknown argument '$1'" >&2; capture_usage >&2; exit 2 ;;
      esac
    done
    ID="$(basename "$DRAFT")"
    ;;
esac

# copy-begin: header-of
# A declared copy: tests/declared-copies.test.sh reds unless every copy of this block is identical.
header_of() {
  awk -F'|' '/^\|/ {
    for (i = 2; i < NF; i++) { v = $i; gsub(/^ +| +$/, "", v); if (v == "ID") { print; exit } }
  }' "$1"
}
# copy-end: header-of
# copy-begin: column-in
# A declared copy: tests/declared-copies.test.sh reds unless every copy of this block is identical.
column_in() {
  printf '%s' "$1" | awk -F'|' -v want="$2" '{
    for (i = 2; i < NF; i++) { v = $i; gsub(/^ +| +$/, "", v); if (v == want) { print i; exit } }
  }'
}
# copy-end: column-in
# copy-begin: decomment
# A declared copy: tests/declared-copies.test.sh reds unless every copy of this block is identical.
DECOMMENT='
function decomment(s,   i, ch, quote, out, start) {
  sub(/^[ \t]+/, "", s)
  start = 1
  ch = substr(s, 1, 1)
  if (ch == "\"" || ch == "\047") { quote = ch; start = 2 }
  for (i = start; i <= length(s); i++) {
    ch = substr(s, i, 1)
    if (quote != "" && ch == quote) { quote = ""; continue }
    if (quote != "")                { out = out ch; continue }
    if (ch == "#" && (i == start || substr(s, i - 1, 1) ~ /[ \t]/)) break
    out = out ch
  }
  sub(/[ \t]+$/, "", out)
  return out
}
'
# copy-end: decomment

# copy-begin: fm-value
# A declared copy: tests/declared-copies.test.sh reds unless every copy of this block is identical.
fm_value() {
  awk -v key="$2" "$DECOMMENT"'
    NR == 1 && /^---$/ { fm = 1; next }
    fm && /^---$/      { exit }
    fm && index($0, key ":") == 1 {
      print decomment(substr($0, length(key) + 2)); exit
    }
  ' "$1"
}
# copy-end: fm-value

# --- refuse malformed input before the lock (FR3) ------------------------------------------------
# Every check here reads only what the caller handed over, so a refusal has nothing to undo.
capture_refuse() { echo "refusing to $VERB $ID: $1" >&2; echo "nothing was changed and no lock was taken" >&2; exit 1; }
has_ac1() { grep -q '^- \[ \] AC1 —' "$1"; }
fm_closed() { awk 'NR == 1 { if ($0 != "---") exit 1; next } /^---$/ { found = 1; exit } END { exit !found }' "$1"; }

[ -f "$QUEUE" ]  || { echo "no QUEUE.md at $QUEUE" >&2; exit 1; }
[ -f "$CONFIG" ] || { echo "no config.yml at $CONFIG" >&2; exit 1; }
[ -x "$DIR/next" ] || { echo "no executable next beside this script — the digest is computed by ./next --ac-digest" >&2; exit 1; }

if [ "$MODE" = capture ]; then
  VERB=capture
  [ -f "$DRAFT" ] && [ -r "$DRAFT" ] || capture_refuse "no readable draft at $DRAFT"
  fm_closed "$DRAFT" || capture_refuse "the draft has no frontmatter: line 1 must be '---' and a second '---' must close it"
  has_ac1 "$DRAFT" || capture_refuse "the draft has no '- [ ] AC1 —' line; a ticket with no criteria cannot be verified"
  TITLE="$(fm_value "$DRAFT" title)"
  [ -n "$TITLE" ] || capture_refuse "the draft has no title:"
  case "$TITLE" in *"|"*) capture_refuse "the title holds '|', which would split its QUEUE.md row" ;; "<"*">") capture_refuse "the title is still the template's placeholder: $TITLE" ;; esac
  D_NEXT="$(fm_value "$DRAFT" next)"
  case "$D_NEXT" in queue|design|develop|verify) : ;; *) capture_refuse "the draft's next: is '$D_NEXT' — expected queue, design, develop or verify" ;; esac
  D_STATUS="$(fm_value "$DRAFT" status)"
  case "$D_STATUS" in ready|waiting|blocked) : ;; *) capture_refuse "the draft's status: is '$D_STATUS' — expected ready, waiting or blocked" ;; esac
  case "$POSITION" in
    top) ANCHOR=""; SIDE="" ;;
    above:[0-9][0-9][0-9][0-9]) ANCHOR="${POSITION#above:}"; SIDE=above ;;
    below:[0-9][0-9][0-9][0-9]) ANCHOR="${POSITION#below:}"; SIDE=below ;;
    *) capture_refuse "'$POSITION' is not a position — expected 'top', 'above:<row-id>' or 'below:<row-id>'" ;;
  esac
  if [ -n "$RANKFILE" ]; then
    [ -f "$RANKFILE" ] && [ -n "$(tr -d ' \t\n' < "$RANKFILE")" ] || capture_refuse "--ranking names no file with text in it: $RANKFILE"
    [ -f "$RANKING" ] || capture_refuse "--ranking was given and there is no RANKING.md at $RANKING"
  fi
  grep -q '^next_id:' "$CONFIG" || capture_refuse "config.yml has no next_id: line to correct"
else
  VERB=restamp
  item="$(ls "$DIR/items/$ID-"*.md 2>/dev/null | head -1 || true)"
  [ -n "$item" ] || capture_refuse "no item file for $ID"
  fm_closed "$item" || capture_refuse "items/$(basename "$item") has no frontmatter to stamp"
  has_ac1 "$item" || capture_refuse "items/$(basename "$item") has no '- [ ] AC1 —' line"
  holder="$(fm_value "$item" claimed_by)"
  [ -z "$holder" ] || capture_refuse "it is claimed by [$holder]; a held ticket's criteria belong to its holder"
fi

# --- the linked-worktree refusal (0083) --------------------------------------------------------
# The lock, QUEUE.md and the items live in the working tree, so a linked worktree's copies are ones
# no other session reads (CONCURRENCY.md, 'A second checkout never writes the backlog').
if git -C "$DIR" rev-parse --git-dir >/dev/null 2>&1 &&
   [ "$(git -C "$DIR" rev-parse --path-format=absolute --git-dir)" != \
     "$(git -C "$DIR" rev-parse --path-format=absolute --git-common-dir)" ]; then
  echo "refusing to $VERB $ID: this is a linked worktree, whose lock and QUEUE.md no other session reads" >&2
  echo "run it from the primary checkout: $(git -C "$DIR" worktree list --porcelain | sed -n '1s/^worktree //p')" >&2
  echo "nothing was changed and no lock was taken" >&2
  exit 1
fi

# copy-begin: shared-branch
# The backlog is written on one branch (0235, 0242 S7). A claim committed on any other branch is
# invisible to every session reading the shared one, so the single-holder guarantee stops at the
# branch: a `prototype/` session once claimed, decided and handed off a row that `main` still read
# as unclaimed. Refuse, never warn, and up front — directly after the linked-worktree refusal,
# before the lock and before any file is read for writing — so the session learns it at `./claim`,
# before it has spent anything on the row. A detached HEAD is off the branch. Outside a git work
# tree the check does not apply. No flag overrides it: the `shared_branch:` key is the one way to
# name another branch. Resolved first hit wins, and nothing fetches:
#   1. `shared_branch:` in this directory's config.yml, comment and blanks stripped (empty = unset)
#   2. `git symbolic-ref --short refs/remotes/origin/HEAD`, its `origin/` removed
#   3. `main`
# See `CONCURRENCY.md`, *The backlog is written on one branch*. $1 is the script's own verb.
refuse_off_shared_branch() {
  git -C "$DIR" rev-parse --git-dir >/dev/null 2>&1 || return 0
  sb=""
  if [ -f "$DIR/config.yml" ]; then
    sb="$(awk '/^shared_branch:/ {
      v = $0; sub(/^shared_branch:/, "", v); sub(/#.*/, "", v); gsub(/[ \t]/, "", v)
      print v; exit
    }' "$DIR/config.yml")"
  fi
  if [ -z "$sb" ] && sb="$(git -C "$DIR" symbolic-ref --short -q refs/remotes/origin/HEAD 2>/dev/null)"; then
    sb="${sb#origin/}"
  fi
  [ -n "$sb" ] || sb="main"
  cur="$(git -C "$DIR" symbolic-ref --short -q HEAD 2>/dev/null)" || cur=""
  [ -n "$cur" ] || cur="HEAD (detached)"
  [ "$cur" != "$sb" ] || return 0
  cfg="$(git -C "$DIR" rev-parse --show-prefix 2>/dev/null || true)config.yml"
  echo "refusing to $1 $ID: this checkout is on '$cur', and the backlog is shared on '$sb'" >&2
  echo "switch with: git switch $sb, or set shared_branch: in $cfg if '$sb' is wrong" >&2
  echo "see references/CONCURRENCY.md, 'The backlog is written on one branch'" >&2
  echo "nothing was changed and no lock was taken" >&2
  exit 1
}
# copy-end: shared-branch
refuse_off_shared_branch "$VERB"

# Anything already changed in a file this commit names would ride along on it, and a pathspec limits
# a commit to paths, never to authorship —
# CONCURRENCY.md, 'A pathspec is necessary but not sufficient'. Staged or not, so against HEAD. Not checked for --restamp's item: its edits are what
# the restamp commits.
git -C "$DIR" rev-parse --git-dir >/dev/null 2>&1 || {
  echo "refusing to $VERB $ID: $DIR is not in a git repository, and a backlog write is a commit" >&2
  echo "nothing was changed and no lock was taken" >&2
  exit 1
}
if [ "$MODE" = capture ]; then
  owned="QUEUE.md config.yml"
  [ -z "$RANKFILE" ] || owned="$owned RANKING.md"
  # shellcheck disable=SC2086
  if ! git -C "$DIR" diff --quiet HEAD -- $owned 2>/dev/null; then
    echo "refusing to capture $ID: $(git -C "$DIR" diff --name-only HEAD -- $owned | tr '\n' ' ')holds uncommitted changes this commit would carry" >&2
    echo "commit them by pathspec if they are yours; if they are another session's, leave them alone and wait" >&2
    echo "nothing was changed and no lock was taken" >&2
    exit 1
  fi
fi

# --- lock, retried while busy, never broken (FR1) ----------------------------------------------
tries="${BACKLOG_LOCK_TRIES:-10}"
until mkdir "$LOCK" 2>/dev/null; do
  tries=$((tries - 1))
  [ "$tries" -gt 0 ] || {
    echo "backlog is locked by: $(cat "$LOCK/held-by" 2>/dev/null || echo unknown)" >&2
    echo "nothing was changed; the lock is another session's, so it was left alone" >&2
    exit 1
  }
  sleep 1
done
printf '%s %s\n%s\n' "$VERB" "$ID" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$LOCK/held-by"
# Set only AFTER the mkdir succeeded: a lock this script did not create is another session's.
CREATED=""
STAGED=""
TMPD=""
cleanup() {
  [ -z "$STAGED" ] || git -C "$DIR" rm -q --cached -- "$STAGED" 2>/dev/null || true
  [ -z "$CREATED" ] || rm -f "$CREATED"
  [ -z "$TMPD" ] || rm -rf "$TMPD"
  rm -rf "$LOCK"
}
trap cleanup EXIT INT TERM
TMPD="$(mktemp -d)"

# Writes `ac_digest: <value>` into $1's frontmatter in place of any it holds, before the closing ---.
stamp_into() {
  t="$TMPD/stamp"
  awk -v line="$2" '
    NR == 1 && /^---$/ { fm = 1; print; next }
    fm && /^ac_digest:/ { next }
    fm && /^---$/ { print line; fm = 0; print; next }
    { print }
  ' "$1" > "$t"
  cat "$t" > "$1"
}

digest_line() {
  d="$("$DIR/next" --ac-digest "$1" 2>/dev/null)" || return 1
  case "$d" in "ac_digest: "?*) printf '%s' "$d" ;; *) return 1 ;; esac
}

commit_paths() {
  msg="$1"; shift
  # Retry briefly: the other window may hold .git/index.lock mid-commit. Never remove that lock.
  n=0
  until git -C "$DIR" commit -q -m "$msg" -m "$COAUTHOR" -- "$@" 2>/dev/null; do
    n=$((n + 1))
    [ "$n" -lt 30 ] || { echo "could not commit (git busy) — nothing was kept" >&2; return 1; }
  done
}

# --- restamp -------------------------------------------------------------------------------------
if [ "$MODE" = restamp ]; then
  holder="$(fm_value "$item" claimed_by)"
  [ -z "$holder" ] || { echo "refusing to restamp $ID: claimed by [$holder] while waiting for the lock" >&2; exit 1; }
  line="$(digest_line "$ID")" || { echo "refusing to restamp $ID: ./next --ac-digest $ID printed no digest" >&2; exit 1; }
  backup="$TMPD/item.bak"; cp "$item" "$backup"
  stamp_into "$item" "$line"
  "$DIR/next" --ac-digest "$ID" --check >/dev/null 2>&1 || {
    cat "$backup" > "$item"
    echo "refusing to restamp $ID: the stamp written did not read back as matching — the item is as it was" >&2
    exit 1
  }
  commit_paths "Restamp $ID ac_digest" "items/$(basename "$item")" || { cat "$backup" > "$item"; exit 1; }
  echo "restamped $ID — $line"
  echo "$ID"
  exit 0
fi

# --- capture: re-read the table under the lock ------------------------------------------------
QHEAD="$(header_of "$QUEUE")"
[ -n "$QHEAD" ] || { echo "no table header in $QUEUE — expected a row with an 'ID' cell" >&2; exit 1; }
missing=""
for want in ID Title Next Status; do
  [ -n "$(column_in "$QHEAD" "$want")" ] || missing="$missing $want"
done
[ -z "$missing" ] || { echo "QUEUE.md's table is missing the column(s):$missing — a shape this script cannot read is an error" >&2; exit 1; }
Q_ID="$(column_in "$QHEAD" ID)"
if [ -n "$ANCHOR" ] && [ -z "$(awk -F'|' -v id="$ANCHOR" -v c="$Q_ID" '/^\|/ { v = $c; gsub(/^ +| +$/, "", v); if (v == id) { print; exit } }' "$QUEUE")" ]; then
  echo "refusing to capture $ID: $SIDE:$ANCHOR names no row in QUEUE.md" >&2
  echo "nothing was changed and the lock is released" >&2
  exit 1
fi

# --- mint from the disk ------------------------------------------------------------------------
mkdir -p "$DIR/items"
NEW="$(ls "$DIR/items" | sed -n 's/^\([0-9][0-9][0-9][0-9]\)-.*\.md$/\1/p' | sort -n | tail -1)"
NEW="$(printf '%s' "${NEW:-0}" | awk '{ printf "%04d", ($1 + 0) + 1 }')"
NEXT_ID="$(printf '%s' "$NEW" | awk '{ print ($1 + 0) + 1 }')"
# The slug is the title, lowercased and hyphenated, cut at a word boundary past 60 characters.
SLUG="$(printf '%s' "$TITLE" | tr 'A-Z' 'a-z' | sed 's/[^a-z0-9][^a-z0-9]*/-/g; s/^-//; s/-$//')"
[ "${#SLUG}" -le 60 ] || SLUG="$(printf '%s' "$SLUG" | cut -c1-61 | sed 's/-[^-]*$//')"
[ -n "$SLUG" ] || SLUG=ticket
item="$DIR/items/$NEW-$SLUG.md"
item_rel="items/$NEW-$SLUG.md"
[ -z "$(ls "$DIR/items/$NEW-"*.md 2>/dev/null || true)" ] || { echo "$NEW is already on disk — refusing to write a second item under it" >&2; exit 1; }

# The item under its id FIRST, then the digest computed over that file: never a stamp from the draft.
CREATED="$item"
awk -v id="$NEW" '
  NR == 1 && /^---$/ { fm = 1; print; print "id: \"" id "\""; next }
  fm && /^id:/ { next }
  fm && /^ac_digest:/ { next }
  fm && /^---$/ { fm = 0 }
  { print }
' "$DRAFT" > "$item"
line="$(digest_line "$NEW")" || { echo "refusing to capture: ./next --ac-digest $NEW printed no digest" >&2; exit 1; }
stamp_into "$item" "$line"

# config.yml: next_id corrected to match the disk, every other line kept.
config_tmp="$TMPD/config.yml"
awk -v n="$NEXT_ID" '/^next_id:/ && !done { print "next_id: " n; done = 1; next } { print }' "$CONFIG" > "$config_tmp"

# QUEUE.md: a row built by that table's own column names, inserted at the given position.
parent="$(fm_value "$item" parent)"
new_row="$(printf '%s' "$QHEAD" | awk -F'|' -v id="$NEW" -v title="$TITLE" -v nx="$D_NEXT" -v st="$D_STATUS" -v parent="$parent" -v q="$QUEUE" '
  {
    out = "|"
    for (i = 2; i < NF; i++) {
      v = $i; gsub(/^ +| +$/, "", v)
      if      (v == "ID")     val = id
      else if (v == "Title")  val = title
      else if (v == "Next")   val = nx
      else if (v == "Status") val = st
      else if (v == "Parent") val = parent
      else                  { val = ""; blank = blank (blank ? ", " : "") v }
      out = out " " val " |"
    }
    if (blank != "") printf "note: %s: left blank (no value this script can author): %s\n", q, blank > "/dev/stderr"
    print out
  }')"
queue_tmp="$TMPD/QUEUE.md"
awk -F'|' -v hdr="$QHEAD" -v side="$SIDE" -v anchor="$ANCHOR" -v idc="$Q_ID" -v row="$new_row" '
  $0 == hdr && !seen { seen = 1; print; hdr_at = NR; next }
  side == "" && hdr_at && NR == hdr_at + 1 { print; print row; next }
  side != "" && /^\|/ { v = $idc; gsub(/^ +| +$/, "", v)
    if (v == anchor && side == "above") { print row; print; next }
    if (v == anchor && side == "below") { print; print row; next } }
  { print }
' "$QUEUE" > "$queue_tmp"

if [ -n "$RANKFILE" ]; then
  ranking_tmp="$TMPD/RANKING.md"
  { cat "$RANKING"; echo; cat "$RANKFILE"; } > "$ranking_tmp"
fi

# --- read the result back before anything moves (handoff's 0087 lesson) ------------------------
unapplied=""
[ "$(fm_value "$item" id)" = "$NEW" ] || unapplied="$unapplied id"
"$DIR/next" --ac-digest "$NEW" --check >/dev/null 2>&1 || unapplied="$unapplied ac_digest"
[ "$(awk -F'|' -v c="$Q_ID" -v id="$NEW" '/^\|/ { v = $c; gsub(/^ +| +$/, "", v); if (v == id) n++ } END { print n + 0 }' "$queue_tmp")" = 1 ] \
  || unapplied="$unapplied QUEUE.row"
grep -qx "next_id: $NEXT_ID" "$config_tmp" || unapplied="$unapplied next_id"
[ -z "$unapplied" ] || { echo "the capture did not apply to:$unapplied — nothing has been written" >&2; exit 1; }

# --- move into place, then commit by pathspec in the same breath -------------------------------
backup_q="$TMPD/QUEUE.bak"; cp "$QUEUE" "$backup_q"
backup_c="$TMPD/config.bak"; cp "$CONFIG" "$backup_c"
cat "$queue_tmp" > "$QUEUE"
cat "$config_tmp" > "$CONFIG"
paths="QUEUE.md config.yml $item_rel"
if [ -n "$RANKFILE" ]; then
  backup_r="$TMPD/RANKING.bak"; cp "$RANKING" "$backup_r"
  cat "$ranking_tmp" > "$RANKING"
  paths="$paths RANKING.md"
fi
restore() {
  cat "$backup_q" > "$QUEUE"; cat "$backup_c" > "$CONFIG"
  [ -z "$RANKFILE" ] || cat "$backup_r" > "$RANKING"
}
# A path git has never seen cannot be named in `git commit -- <path>`; add it, and only it.
git -C "$DIR" add -- "$item_rel"
STAGED="$item_rel"
# shellcheck disable=SC2086
commit_paths "Capture $NEW: $TITLE" $paths || { restore; exit 1; }
CREATED=""
STAGED=""

echo "captured $NEW — $TITLE: next $D_NEXT, status $D_STATUS, at $POSITION; next_id: $NEXT_ID"
echo "$NEW"
