#!/bin/sh
#
# Claim a backlog row: lock → edit QUEUE.md → write the item's frontmatter → commit → unlock,
# as one atomic step.
#
# **The commit is why this is a script and not a rule in a document.** A claim edits QUEUE.md,
# and until something commits that edit it sits dirty in the file both windows share — so the
# next window to close anything commits it for you, under its own message. That is not
# hypothetical: one project's close carried two pending claims exactly that way. Timing
# discipline cannot fix it, because the foreign edit is already in the file before you touch it.
# The only fix is upstream — never leave the claim uncommitted — and a script cannot forget.
#
# Usage:  .claude/backlog/claim <id> [token]
#
# **`touches:` is written here, provisionally, from the item's `expects:`.** It used to be printed
# as an instruction, which made the one field the other window reads to decide what is safe to take
# the only part of a claim that was neither written nor committed atomically — and it was skipped
# exactly as often as that invites. `expects:` is a prediction and not a verified scope, so the
# session still has to narrow it to what it will actually open and widen it the moment the work
# reaches further; a provisional scope is wrong in the direction that costs a suboptimal pick,
# where an absent one is read as "every file this item names is held" (`CONCURRENCY.md`, *The
# working tree is shared too*). An item with no `expects:` gets no invented scope and is told so.
#
# **Columns are resolved by header name, never by position.** The table's shape is not a contract:
# it was pared from eight columns to five, and a parser keyed on a fixed index then read every
# row's status as empty and refused every claim — silently, with a message that blamed the row.
# A session's honest reading of that is "the backlog has nothing takeable". So: match the header
# cell by name, work against any column order or count, and make a missing `Status` column a loud
# error rather than a refusal. Ownership is not read from a column at all; it lives in the item's
# `claimed_by:`.
#
# See references/CONCURRENCY.md — 'A claim must be durable the moment it is made'.

set -eu

DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
QUEUE="$DIR/QUEUE.md"
LOCK="$DIR/.lock"

ID="${1:-}"
[ -n "$ID" ] || { echo "usage: claim <id> [token]" >&2; exit 2; }
[ -f "$QUEUE" ] || { echo "no QUEUE.md at $QUEUE" >&2; exit 1; }

TOKEN="${2:-$(head -c2 /dev/urandom | xxd -p)}"

# --- the fourth refusal: a foreign edit this claim's commit would carry ------------------------
# This script used to *warn* here and commit anyway, which is the shape a warning always has: it
# was right, it was read, and the other window's row went into the git record under this claim's
# message all the same (AetherWorks 0091, carried by `Claim 0034 [fc89]`). A pathspec limits a
# commit to the paths it names and never to the changes you made, so there is no version of the
# commit below that can leave a foreign row behind — the only fix is upstream, and a script
# holding the lock can refuse where a person under load cannot.
#
# **Before the lock, deliberately.** A refusal that has taken the lock has something to undo, and
# a refusal that has edited the row has something worse; refusing here is the only point at which
# "changes nothing" is true by construction rather than by cleanup (0082 AC4).
#
# **Pathspec here is relative to `$DIR`, deliberately — do not "tidy" it back to `$QUEUE`.** It is
# absolute, and on a case-insensitive filesystem `$DIR` can spell the repo path in a different case
# from `git rev-parse --show-toplevel`, which makes an absolute pathspec read as *outside the repo*.
# With a single pathspec there is no second file to compare against, so the check degrades to a
# silent pass instead of a loud wrong answer — the direction that loses work rather than time.
if git -C "$DIR" rev-parse --git-dir >/dev/null 2>&1 && ! git -C "$DIR" diff --quiet -- QUEUE.md; then
  echo "refusing to claim $ID: QUEUE.md holds uncommitted changes this claim's commit would carry" >&2
  echo "the rows that would land under 'Claim $ID [$TOKEN]':" >&2
  git -C "$DIR" diff -U0 -- QUEUE.md | awk '/^[+-]\| / { print "  " $0 }' >&2
  echo "commit them by pathspec if they are yours; if they are another session's, leave them alone" >&2
  echo "and wait, or 'git restore -- .claude/backlog/QUEUE.md' if you know they are stray" >&2
  echo "nothing was changed and no lock was taken" >&2
  exit 1
fi

# --- lock -------------------------------------------------------------------------------------
mkdir "$LOCK" 2>/dev/null || {
  echo "backlog is locked by: $(cat "$LOCK/held-by" 2>/dev/null || echo unknown)" >&2
  exit 1
}
echo "claim $ID by $TOKEN" > "$LOCK/held-by"
# Release the lock however we leave, so a failed claim never strands the other window.
trap 'rm -rf "$LOCK"' EXIT INT TERM

# --- find the columns by name, under the lock -------------------------------------------------
# Under the lock, so the shape we write to is the shape we read. A pre-pared eight-column table
# and the current five-column one differ only in where `Status` sits; both are claimable.
#
# `ID` is resolved by name too. Resolving one column by name and the other by position would make
# the header comment's promise false in exactly the case nobody tests: the parser would look
# order-independent and still read the wrong cell the day a column moves in front of `ID`.
header="$(awk -F'|' '/^\|/ {
  for (i = 2; i < NF; i++) { v = $i; gsub(/^ +| +$/, "", v); if (v == "ID") { print; exit } }
}' "$QUEUE")"
[ -n "$header" ] || { echo "no table header in $QUEUE — expected a row with an 'ID' cell" >&2; exit 1; }

column_named() {
  printf '%s' "$header" | awk -F'|' -v want="$1" '{
    for (i = 2; i < NF; i++) { v = $i; gsub(/^ +| +$/, "", v); if (v == want) { print i; exit } }
  }'
}

ID_COL="$(column_named ID)"
STATUS_COL="$(column_named Status)"
[ -n "$STATUS_COL" ] || {
  echo "no Status column in the QUEUE.md table — cannot tell a ready row from a blocked one" >&2
  echo "header found: $header" >&2
  exit 1
}

# --- re-read the row under the lock -----------------------------------------------------------
# It may have changed since it was chosen; proceeding on a stale read is the whole race.
row="$(awk -F'|' -v id="$ID" -v c="$ID_COL" '/^\|/ { v = $c; gsub(/^ +| +$/, "", v); if (v == id) { print; exit } }' "$QUEUE")"
[ -n "$row" ] || { echo "no row for $ID in QUEUE.md" >&2; exit 1; }

status="$(printf '%s' "$row" | awk -F'|' -v c="$STATUS_COL" '{ v = $c; gsub(/^ +| +$/, "", v); print v }')"
[ "$status" = "ready" ] || {
  echo "$ID is '$status', not ready — pick another row" >&2
  if [ "$status" = "in-progress" ]; then
    echo "who holds it is the item's claimed_by:, in items/$ID-*.md — not a queue column" >&2
  fi
  exit 1
}

# --- edit the row -----------------------------------------------------------------------------
# The Status cell and nothing else. The token goes in the item's frontmatter, so a legacy table
# that still carries an Owner column keeps whatever is already in it.
tmp="$(mktemp)"
awk -F'|' -v OFS='|' -v id="$ID" -v idc="$ID_COL" -v c="$STATUS_COL" '
  /^\|/ {
    v = $idc; gsub(/^ +| +$/, "", v)
    if (v == id) { $c = " in-progress " }
  }
  { print }
' "$QUEUE" > "$tmp"
mv "$tmp" "$QUEUE"

# --- item frontmatter -------------------------------------------------------------------------
item="$(ls "$DIR/items/$ID-"*.md 2>/dev/null | head -1 || true)"
[ -n "$item" ] || { echo "no item file for $ID" >&2; exit 1; }

now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
tmp="$(mktemp)"
count="$(mktemp)"
# The ownership keys are *replaced* where they exist and *added* where they do not. An item
# written before the template carried them has nothing to replace, and a silent skip is the worst
# outcome available: the row says claimed, the script says claimed, and the item file records no
# owner at all — so the "did I mint this token?" test in CONCURRENCY.md has nothing to read.
# `touches:` is the third such key and is written the same way, from `expects:` (0082 FR1).
#
# One pass, and one parser: the entry count the report below branches on is written out by this
# awk rather than recomputed by a second one, because two parsers of the same frontmatter drift
# and the drift is silent — the file would say one thing and the report another.
#
# The array is `want[]` and not `exp[]`: `exp` is an awk BUILT-IN (exponential), and using it as
# an array name is a parse error reported as `illegal statement` on the line that reads it, which
# points at the loop rather than at the name.
#
# Every rule is guarded on `fm`. Without it the `intou`/`inexp` list rules would swallow an
# indented bullet in the item's PROSE, which is a data-loss bug that no assertion about
# frontmatter can see.
awk -v tok="$TOKEN" -v now="$now" -v cf="$count" '
  NR == 1 && /^---$/ { fm = 1; print; next }
  fm && /^---$/      {
    if (!by)  { print "claimed_by: \"" tok "\""; added = 1 }
    if (!at)  { print "claimed_at: " now;         added = 1 }
    if (!tou && n) { print "touches:"; for (i = 1; i <= n; i++) print want[i]; added = 1 }
    fm = 0
    if (added) print "note: item predated some of the claim keys; added them" > "/dev/stderr"
    print; next
  }
  fm && /^expects:/    { inexp = 1; print; next }
  fm && inexp && /^[ \t]+-/ { want[++n] = $0; print; next }
  fm && inexp          { inexp = 0 }
  fm && /^touches:/    {
    print "touches:"
    for (i = 1; i <= n; i++) print want[i]
    tou = 1; intou = 1; next
  }
  fm && intou && /^[ \t]+-/ { next }
  fm && intou          { intou = 0 }
  fm && /^claimed_by:/ { print "claimed_by: \"" tok "\""; by = 1; next }
  fm && /^claimed_at:/ { print "claimed_at: " now;         at = 1; next }
  fm && /^status:/     { print "status: in-progress"; next }
  { print }
  END { print n + 0 > cf }
' "$item" > "$tmp"
mv "$tmp" "$item"
N_EXPECTS="$(cat "$count")"
rm -f "$count"

# --- commit, by pathspec, in the same breath as the edit --------------------------------------
# Retry briefly: the other window may hold .git/index.lock mid-commit. Never remove that lock.
if git -C "$DIR" rev-parse --git-dir >/dev/null 2>&1; then
  n=0
  until git -C "$DIR" commit -q -m "Claim $ID [$TOKEN]" -- "$QUEUE" "$item" 2>/dev/null; do
    n=$((n + 1))
    [ "$n" -lt 30 ] || { echo "could not commit the claim (git busy); QUEUE.md is edited but uncommitted" >&2; exit 1; }
  done
fi

echo "claimed $ID with token $TOKEN"
if [ "${N_EXPECTS:-0}" -gt 0 ]; then
  echo "touches: is set provisionally from expects: ($N_EXPECTS paths) — NARROW it in $item to"
  echo "what you will actually open, and widen it the moment the work reaches further"
else
  echo "touches: is unset: $ID declares no expects:, and a scope invented from nothing would be"
  echo "worse than none — set it in $item before you open anything"
fi
