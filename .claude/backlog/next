#!/bin/sh
#
# What a session needs to start work, in a fixed handful of lines.
#
# Reading QUEUE.md whole costs more context every time the queue grows, and the queue is the
# file both windows edit most — so it is also the file the harness re-echoes most often. This
# answers the three questions almost every read actually has: what may I take for my stage, what
# is waiting on a person, and which files another session has claimed. Its output is the same size
# whether the queue holds ten rows or three hundred.
#
# It is a reader and nothing else: it never writes, never takes the lock, and never decides.
# Claiming a row is `./claim <id>`, which locks, edits, commits and unlocks in one step — see
# references/CONCURRENCY.md for why the commit is the part that matters.
#
# Two modes answer a driver rather than a human. `--drive` says what should happen next and spends a
# distinct exit code per outcome, because a human reading "nothing is takeable" off a zero gets away
# with it and a loop does not; `--findings` counts the findings buffer, tolerant of both entry
# shapes it actually carries. Both are documented under `--help` and specified by 0038. `--drive`
# runs `--drift`'s check before it picks a gate (0142): the classes that stop a human reading that
# report were invisible to the one reader that is never a person.
#
# Read the whole file when you genuinely need the whole file — a re-rank, a themes pass, or any
# judgement about *order* rather than about what to do next.

set -eu

DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
QUEUE="$DIR/QUEUE.md"

CONFIG="$DIR/config.yml"
FINDINGS="$DIR/FINDINGS.md"
DONE="$DIR/DONE.md"

# The findings-buffer threshold a driver gates on. It lives in config.yml so a project can raise it
# without editing this script — this repo's own rate is inflated because its tickets are *about* the
# tooling, so every one surfaces a tooling defect. The default is `retro`'s stated cadence, and
# `retro` points at this key rather than carrying a second number.
FINDINGS_THRESHOLD_DEFAULT=8
THRESHOLD="$FINDINGS_THRESHOLD_DEFAULT"

# Loud rather than defaulted: a driver silently gating on 8 where the project wrote 20 is the same
# class of defect as a count that reads low — wrong, and with nothing to notice it by.
#
# `sub(/#.*/, "")` is correct here and wrong in `fm_list` below. Do not unify them: a threshold is a
# number, so a `#` in it can only be a comment, where a `#` in a path can be part of the path.
read_threshold() {
  [ -f "$CONFIG" ] || return 0
  raw="$(awk '/^findings_threshold:/ {
    v = $0; sub(/^findings_threshold: */, "", v); sub(/#.*/, "", v); gsub(/[ \t]/, "", v)
    print v; exit
  }' "$CONFIG")"
  [ -n "$raw" ] || return 0
  case "$raw" in
    *[!0-9]*) echo "findings_threshold in $CONFIG is not a whole number: $raw" >&2; return 1 ;;
  esac
  THRESHOLD="$raw"
}

# Entries in FINDINGS.md, tolerant of both shapes the file carries: `- <date> — lead.` and
# `- **<date> — lead.**`. The obvious `^- 2026-` grep sees only the first, and MEASUREMENT.md
# published 26 and 28 in adjacent sentences against a format-tolerant 42. A gate reading a reliably
# low number fires late, silently, and nothing goes red when it does.
#
# A third shape is neither counted nor ignored — it is named, and the caller fails. A count nobody
# can trust is worse than no count, because it looks like one.
#
# THE COUNT IS EVERY ENTRY, AND WHAT MAKES THAT REDUCIBLE IS AN INVARIANT IN ANOTHER FILE (0060).
# `retro` is the TERMINAL SWEEPER: `skills/retro/SKILL.md` Step 4 gives every entry it reads one of
# four dispositions and states that `no entry survives the pass that read it`. So every entry left
# in this file is work a retro can still do, and the gate below is satisfiable by the stage it
# dispatches. Lose that sentence and this counter silently becomes what it was before 0060 — a gate
# only the OTHER sweeper could clear, diverting drivers into retros that correctly find nothing.
# tests/findings-buffer.test.sh guards the sentence for this reason; do not delete it as a
# duplicate of the disposition guard in tests/retro-tool-edit.test.sh, which asserts the same words
# about a different claim.
#
# A marker-aware count that skipped `[->NNNN]` entries was considered and REJECTED in design: it
# goes quiet exactly when deferred and handed-over entries pile up, which is when the gate's whole
# job is to be loud. The token sits after the date precisely so both shapes below still match it.
#
# $1 the buffer to read, named in any MALFORMED line so a second buffer's bad entry is not hunted
# for in the wrong repo.
count_findings() {
  awk -v src="$1" '
    function dated(s)  { return s ~ /^- [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/ }
    function bolded(s) { return s ~ /^- \*\*[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/ }
    # The preamble above the rule is prose about the file, and counting it inflates every read.
    !body && /^---$/ { body = 1; next }
    !body { next }
    /^- / {
      if (dated($0) || bolded($0)) { n++; next }
      printf "MALFORMED %s:%d  %s\n", src, NR, $0
      bad = 1
    }
    END { printf "COUNT %d %d\n", n + 0, bad + 0 }
  ' "$1"
}

# --- the gate's SECOND limit: time served rather than volume (0133) ----------------------------
#
# The count alone strands a low-yield project. A repo parking two findings a sprint never reaches a
# threshold of eight, so its buffer is never swept, and the lessons in it are never landed — the
# gate is silent in exactly the case where nothing else will notice.
#
# THE UNIT IS COMPLETED SPRINTS, NOT CALENDAR DAYS, and the reason is that the gate is only ever
# evaluated when a sprint ends. A dormant project's calendar clock runs while nothing is there to
# read it, so a window and a sprint count fire identically on the next sprint whenever it comes —
# and the sprint count is the one that measures what it claims to: opportunities offered and missed.
#
# WHERE THE COUNT COMES FROM, and why it is not a counter in config.yml beside `next_id`. A
# supervisor may not take the backlog lock (`sprint` Step 7), and every write to this directory
# needs it (`CONCURRENCY.md`, *Lock every write to the backlog directory*) — so the one durable
# record a supervisor can write is its own per-run log, which is single-writer and needs no lock.
# A completed sprint is therefore a run log carrying a `sprint_ended` event. Counting FILES instead
# would score a supervisor killed mid-run as an opportunity the buffer was offered, which is the
# opposite of true.
#
# Loud rather than defaulted, for read_threshold's reason: a driver gating on 2 where the project
# wrote 6 is wrong with nothing to notice it by.
MAX_SPRINTS=2
read_max_sprints() {
  [ -f "$CONFIG" ] || return 0
  raw="$(awk '/^findings_max_sprints:/ {
    v = $0; sub(/^findings_max_sprints: */, "", v); sub(/#.*/, "", v); gsub(/[ \t]/, "", v)
    print v; exit
  }' "$CONFIG")"
  [ -n "$raw" ] || return 0
  case "$raw" in
    *[!0-9]*) echo "findings_max_sprints in $CONFIG is not a whole number: $raw" >&2; return 1 ;;
  esac
  MAX_SPRINTS="$raw"
}

RUNS="$DIR/runs"

# The earliest date any entry in either buffer carries, or nothing where both are empty. The OLDEST
# and never the newest: a buffer still receiving entries would otherwise reset its own clock every
# sprint, which is precisely the low-yield project this limit exists for.
#
# Both entry shapes `count_findings` tolerates are read here too, and by the same preamble rule —
# two readers disagreeing about which lines are entries is 0060's defect in miniature.
oldest_entry_date() {
  for oed_buf in "$FINDINGS" "$TOOLS_FINDINGS"; do
    [ -n "$oed_buf" ] && [ -f "$oed_buf" ] || continue
    awk '
      !body && /^---$/ { body = 1; next }
      !body { next }
      /^- / {
        v = $0
        sub(/^- (\*\*)?/, "", v)
        if (v ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/) print substr(v, 1, 10)
      }
    ' "$oed_buf"
  done | sort | head -n 1
}

# How many sprints have ENDED since $1, an ISO date.
#
# STRICTLY AFTER, and that is an ACKNOWLEDGED OVER-STRICTNESS rather than an oversight. An entry
# carries a date and a run an instant, so on a shared day there is no fact saying which came first.
# Not counting it delays the gate by at most one sprint; counting it fires the whole tail on a
# finding parked minutes before the run ended, which is the worse of the two by the cost of a tail.
sprints_since() {
  [ -d "$RUNS" ] || { printf '0\n'; return 0; }
  ss_n=0
  for ss_f in "$RUNS"/*.jsonl; do
    [ -f "$ss_f" ] || continue
    ss_hit="$(awk -v since="$1" '
      /"event"[ \t]*:[ \t]*"sprint_ended"/ {
        if (match($0, /"at"[ \t]*:[ \t]*"[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/)) {
          d = substr($0, RSTART + RLENGTH - 10, 10)
          if (d > since) { print "yes"; exit }
        }
      }
    ' "$ss_f")"
    [ -z "$ss_hit" ] || ss_n=$((ss_n + 1))
  done
  printf '%s\n' "$ss_n"
}

# Sets FOLDEST and FAGE. Call after `tally_findings`, which is what resolves the second buffer.
FOLDEST=""
FAGE=0
tally_age() {
  FOLDEST="$(oldest_entry_date)"
  FAGE=0
  [ -n "$FOLDEST" ] || return 0
  FAGE="$(sprints_since "$FOLDEST")"
}

# The age half of the gate, as one predicate both readers share. An EMPTY buffer never crosses it,
# however many sprints have ended: a sprint that parks nothing ends without a tail (0133 FR1), and
# a tail costs about $6.75 against a one-ticket sprint that may cost less.
age_gate_crossed() {
  [ -n "$FOLDEST" ] || return 1
  [ "$FCOUNT" -gt 0 ] || return 1
  [ "$FAGE" -ge "$MAX_SPRINTS" ]
}

# --- the second buffer, and only the second (0060 FR10) ----------------------------------------
#
# The gate counts the buffers the retro it would dispatch will actually READ. `retro` Step 1 reads
# the resolved local buffer, plus the tools repo's where one is configured — so a gate counting only
# the local one under-reports a project whose sessions park tool findings by subject, and a gate
# counting anything MORE would fire for a buffer its own retro cannot reach, which is the defect
# this ticket opened on. Sibling backlogs under a shared workspace are deliberately not counted:
# 0111 FR5 makes them unreachable by construction.
#
# RESOLVED, NEVER DISCOVERED, and never derived from the plugin install — references/CONVENTIONS.md,
# *Routing a finding to the repo it is about*, is where that is settled. Relative paths resolve from
# the project root, exactly as `conventions.path` does.
#
# Unlike the threshold, a `#` is NOT stripped here: it can be part of a path. That asymmetry is
# stated in read_threshold above and is the reason these two readers are not unified.
TOOLS_FINDINGS=""
TOOLS_NOTE=""
read_tools_buffer() {
  TOOLS_FINDINGS=""
  TOOLS_NOTE="local buffer only — config.yml names no tools.path"
  [ -f "$CONFIG" ] || return 0
  tpath="$(awk '
    /^tools:[ \t]*$/ { intools = 1; next }
    intools && /^[^ \t#]/ { intools = 0 }
    intools && /^[ \t]+path:/ {
      v = $0; sub(/^[ \t]*path:[ \t]*/, "", v)
      sub(/[ \t]+$/, "", v)
      print v; exit
    }
  ' "$CONFIG")"
  [ -n "$tpath" ] || return 0

  case "$tpath" in
    /*) troot="$tpath" ;;
    *)  troot="$DIR/../../$tpath" ;;
  esac
  tbuf="$troot/.claude/backlog/FINDINGS.md"

  if [ ! -f "$tbuf" ]; then
    TOOLS_NOTE="local buffer only — tools.path $tpath did not resolve to a backlog buffer"
    return 0
  fi
  # A project configured to point at ITSELF would otherwise double every entry it holds, and the
  # gate would fire at half the threshold with nothing to show for it. The template tells a tool
  # repo to omit the key; this is what happens when it does not.
  if [ "$(cd -- "$(dirname -- "$tbuf")" && pwd)/$(basename -- "$tbuf")" \
     = "$(cd -- "$(dirname -- "$FINDINGS")" && pwd)/$(basename -- "$FINDINGS")" ]; then
    TOOLS_NOTE="local buffer only — tools.path resolves to this project's own buffer"
    return 0
  fi
  TOOLS_FINDINGS="$tbuf"
  TOOLS_NOTE=""
}

# Sets FCOUNT (the total the gate reads), FLOCAL, FTOOLS and FBAD, and prints any MALFORMED line
# from either buffer. One tally, so the line a human reads and the code a driver routes on can
# never report different numbers — two counts over one question is this ticket's own defect in
# miniature.
tally_findings() {
  FLOCAL=0; FTOOLS=0; FBAD=0
  if [ -f "$FINDINGS" ]; then
    lrep="$(count_findings "$FINDINGS")"
    printf '%s\n' "$lrep" | grep '^MALFORMED' || true
    FLOCAL="$(printf '%s\n' "$lrep" | awk '/^COUNT/ { print $2; exit }')"
    [ "$(printf '%s\n' "$lrep" | awk '/^COUNT/ { print $3; exit }')" = 0 ] || FBAD=1
  fi
  if [ -n "$TOOLS_FINDINGS" ]; then
    trep="$(count_findings "$TOOLS_FINDINGS")"
    printf '%s\n' "$trep" | grep '^MALFORMED' || true
    FTOOLS="$(printf '%s\n' "$trep" | awk '/^COUNT/ { print $2; exit }')"
    [ "$(printf '%s\n' "$trep" | awk '/^COUNT/ { print $3; exit }')" = 0 ] || FBAD=1
  fi
  FCOUNT=$((FLOCAL + FTOOLS))
}

# The provenance line: which buffers that total came from. A count whose sources are not named
# cannot be argued with — and where a second buffer was expected and missed, the miss is the thing
# worth seeing.
findings_sources() {
  if [ -n "$TOOLS_FINDINGS" ]; then
    printf 'local %s (%s) + tools %s (%s)\n' "$FLOCAL" "$FINDINGS" "$FTOOLS" "$TOOLS_FINDINGS"
  else
    printf '%s (%s)\n' "$TOOLS_NOTE" "$FINDINGS"
  fi
}

usage() {
  cat <<'USAGE'
usage: ./next [<stage> | --waiting | --drift | --findings | --drive [--propose] [--completed <stage>[:<id>]] [--started <id>]… | --help]

  ./next             counts by stage and by status, plus anything another session holds
  ./next <stage>     the first takeable row for that stage, and its size
                     stages: queue | design | develop | verify
  ./next --waiting   every waiting row with the question it is waiting on
  ./next --drift     every row that disagrees with its blocked_by or with its own item —
                     stage, status, a claim the row does not match either way, a missing item file;
                     one line per row, exits 1 if any
  ./next --findings  how many entries FINDINGS.md holds, and the TWO limits a driver gates on:
                     the count against findings_threshold, and the oldest entry's age in completed
                     sprints against findings_max_sprints. Either one crossed dispatches the tail
  ./next --drive     what should happen next, for a driver rather than a human: one decision line,
                     how deep the backlog is, and a distinct exit code per outcome. It runs the
                     same drift check --drift runs before it picks a gate, and escalates on it:
                     a drifted queue is not a finished one.
                     --completed <stage>[:<id>] says which stage just finished on which ticket.
                     That input is what tells a verify bounce from a fresh develop row, and a
                     crash-recovery re-dispatch from a loop. Give it at most once.
                     --started <id> names a ticket this RUN has already opened work on —
                     repeatable, and cumulative over the whole run rather than over the last call.
                     While one of them is still awaiting verify, no NEW develop gate is dispatched:
                     work that was started gets finished. --completed's id is unioned in, so a run
                     whose gates are all single tickets needs no --started at all.
                     --propose describes the dispatch a person is being asked to approve — how many
                     tickets, which, a line of work each, and what holds the gate together — and is
                     for the ONE call a run makes before its first stage. Opt-in because every later
                     cycle would re-send the same block into the driver's context for nothing.
  ./next --help      this

Takeable means four things: `next` matches the stage, no `blocked_by` entry is still open, the
item carries no claim, and no file the row `expects:` is already held by a held row's `touches:`.
Ownership is the item's `claimed_by:` and the Status column is a cache of it, so a row reading
`ready` over a held ticket is skipped and reported — references/CONCURRENCY.md, *A stage writes
only the ticket it holds*, is where that is settled. `blocked` is
DERIVED from `blocked_by`, so the column is a cache of that answer and never the authority — a
row is offered on the graph's answer whatever the column says, and the disagreement is reported.

A row held out on that third test is reported as COLLIDES, naming the shared paths and the row
holding them, and the walk carries on to the next clear row rather than stopping at the first
stage match. The held set spans every stage: a develop row can collide with a live verify claim.
Where every row at the stage collides, the closing line says so in different words from an
empty stage — the two mean different things to whoever reads them.

--drive spends a code per outcome, and they are the contract: 0 dispatch this · 3 run complete,
nothing takeable · 4 escalate, a person decides, drift included · 5 the findings gate is reached,
dispatch retro. 1 (drift, malformed) and 2 (usage error) mean what they mean everywhere else —
--drive reports drift on 4 rather than on 1 because what it has found is a decision for a person,
which is the one thing 4 already means. Every other mode still spends 0 on "nothing is takeable",
which is why --drive could not reuse it.
USAGE
}

case "${1:-}" in
  -h|--help|help) usage; exit 0 ;;
esac

# --- --findings -------------------------------------------------------------------------------
# Ahead of the QUEUE.md check on purpose: the buffer's size is not a question about the table, and
# a driver asking it on a project mid-scaffold should get the count rather than a parse error.
if [ "${1:-}" = "--findings" ]; then
  read_threshold || exit 1
  read_max_sprints || exit 1
  read_tools_buffer
  if [ ! -f "$FINDINGS" ] && [ -z "$TOOLS_FINDINGS" ]; then
    printf 'FINDINGS  0 entries; threshold %s — no FINDINGS.md at %s\n' "$THRESHOLD" "$FINDINGS"
    exit 0
  fi
  tally_findings
  if [ "$FCOUNT" -ge "$THRESHOLD" ]; then state='at or over the threshold'; else state='under the threshold'; fi
  printf 'FINDINGS  %s entries; threshold %s (config.yml findings_threshold) — %s\n' \
    "$FCOUNT" "$THRESHOLD" "$state"
  printf '          %s' "$(findings_sources)"
  printf '\n'
  # The second limit, printed only where there is an entry to date. A line reading `oldest entry
  # (none)` on an empty buffer invites the reading that the tail is merely overdue.
  tally_age
  if [ -n "$FOLDEST" ]; then
    if age_gate_crossed; then astate='at or over the limit'; else astate='under the limit'; fi
    printf '          oldest entry %s has survived %s completed sprint(s); limit %s (config.yml findings_max_sprints) — %s\n' \
      "$FOLDEST" "$FAGE" "$MAX_SPRINTS" "$astate"
  fi
  [ "$FBAD" = 0 ] || {
    echo "the count above is not trustworthy: an entry matches neither '- <date>' nor '- **<date>'" >&2
    exit 1
  }
  exit 0
fi

[ -f "$QUEUE" ] || { echo "no QUEUE.md at $QUEUE" >&2; exit 1; }

# ---------------------------------------------------------------------------------------------
# The table shape, resolved two ways for one reason.
#
# Fixed indices are checked rather than assumed, because the failure mode of a silently wrong
# index is the worst one available: this script prints "0 ready of 2 rows" against a table it
# cannot read, and a session concludes the backlog is empty rather than that the parser is wrong.
# That happened once already. Refusing to run against a shape we cannot read is the floor.
#
# 0038's FR18 raises the floor for the NEW modes only: they resolve columns by header *name*, so a
# moved column changes nothing, and 0006 still owns converting the pre-existing ones. Writing
# `--drive` against fixed indices would have handed 0006 a second index-based reader to rewrite and
# a second chance to be silently wrong until it did.
#
# So the pre-existing modes keep the fixed-shape assertion they have always made — verbatim, message
# included, because three closed tickets and two scripts read what they return — and `--drive` skips
# it. The by-name resolution below then runs for every mode; on the canonical table it yields the
# same 2/3/4/5, so nothing that worked reads a different cell.
# ---------------------------------------------------------------------------------------------
if [ "${1:-}" != "--drive" ]; then
  header="$(awk '/^\| *ID *\|/ { print; exit }' "$QUEUE")"
  [ -n "$header" ] || { echo "no table header in $QUEUE — expected a row starting '| ID |'" >&2; exit 1; }
  shape="$(printf '%s' "$header" | awk -F'|' '{
    for (i = 2; i < NF; i++) { v = $i; gsub(/^ +| +$/, "", v); printf "%s%s", (i > 2 ? "/" : ""), v }
  }')"
  [ "$shape" = "ID/Title/Next/Status/Parent" ] || {
    echo "unexpected table shape: $shape" >&2
    echo "this reader parses ID/Title/Next/Status/Parent by position; fix the table or the reader" >&2
    exit 1
  }
fi

# `ID` is resolved by name too. Resolving one column by name and another by position would make the
# promise above false in exactly the case nobody tests: the parser would look order-independent and
# still read the wrong cell the day a column moves in front of `ID`.
name_row="$(awk -F'|' '/^\|/ {
  for (i = 2; i < NF; i++) { v = $i; gsub(/^ +| +$/, "", v); if (v == "ID") { print; exit } }
}' "$QUEUE")"
[ -n "$name_row" ] || { echo "no table header in $QUEUE — expected a row with an 'ID' cell" >&2; exit 1; }

column_named() {
  printf '%s' "$name_row" | awk -F'|' -v want="$1" '{
    for (i = 2; i < NF; i++) { v = $i; gsub(/^ +| +$/, "", v); if (v == want) { print i; exit } }
  }'
}

ID="$(column_named ID)"
TITLE="$(column_named Title)"
NEXT="$(column_named Next)"
STATUS="$(column_named Status)"

# Routing is impossible without these three, and a missing column reads as empty on every row —
# which presents as "nothing is takeable" rather than as a broken parser. That is the same failure
# the fixed-shape check refuses, arriving through the new door, so it is refused here too.
for required in "ID:$ID" "Next:$NEXT" "Status:$STATUS"; do
  case "$required" in
    *:) echo "no ${required%%:*} column in the QUEUE.md table — cannot route on a cell that is not there" >&2
        echo "header found: $name_row" >&2
        exit 1 ;;
  esac
done

# The header and separator rows are recognised by the ID *cell*, not by cell 2 — under a reordered
# table cell 2 holds something else, and the header would come back as a data row.
rows() {
  awk -F'|' -v n="$ID" '/^\|/ {
    id = $n; gsub(/^ +| +$/, "", id)
    if (id == "ID" || id ~ /^-+$/ || id == "") next
    print
  }' "$QUEUE"
}

field() { printf '%s' "$1" | awk -F'|' -v n="$2" '{ v = $n; gsub(/^ +| +$/, "", v); print v }'; }

row_for() { rows | awk -F'|' -v id="$1" -v n="$ID" '{ v = $n; gsub(/^ +| +$/, "", v); if (v == id) { print; exit } }'; }

# Ids whose row matches a column value. Ids carry no whitespace, so callers can iterate them with a
# plain `for` — which keeps the loop in this shell rather than a pipeline subshell, where a counter
# set inside would be discarded and every "did anything match?" test would read false.
ids_where() { rows | awk -F'|' -v n="$1" -v want="$2" -v idc="$ID" '{ v = $n; gsub(/^ +| +$/, "", v); if (v == want) { id = $idc; gsub(/^ +| +$/, "", id); print id } }'; }

all_ids() { rows | awk -F'|' -v n="$ID" '{ v = $n; gsub(/^ +| +$/, "", v); print v }'; }

item_for() { ls "$DIR/items/$1-"*.md 2>/dev/null | head -1 || true; }

# YAML's comment rule, as awk source text injected into every frontmatter reader below. awk has no
# include, so a shared implementation is a string rather than a file; `close` carries this same
# block for its own two readers, and the two scripts are separate files by install contract
# (`tests/backlog-scripts-installed.test.sh` AC2). Change one, change both.
#
# It applies to SCALARS as much as to lists, and that asymmetry was the defect: 0031 taught the
# list reader to strip comments while `fm` kept returning `aa11" # mine` for an annotated token —
# and `close` compares exactly that string against the token it is given before it will close
# anything (0044).
#
# `sub(/#.*/, "")` is the obvious form and it is wrong twice, so do not simplify it back:
#   - `- "docs/a#b.md"` is a legal quoted path, and the naive form truncates it to `docs/a`;
#   - in YAML a `#` only opens a comment at the start of a value or after whitespace, so `a#b`
#     unquoted is one token too.
# Hence: a quote only quotes when it is the value's first character (mid-value it is a literal, so
# `it's/a/path.md` keeps its apostrophe), and a `#` only cuts when it opens the value or follows a
# space or tab. `"\047"` is that apostrophe — this block is single-quoted shell.
DECOMMENT='
function decomment(s,   i, ch, quote, out, start) {
  sub(/^[ \t]+/, "", s)
  start = 1
  ch = substr(s, 1, 1)
  if (ch == "\"" || ch == "\047") { quote = ch; start = 2 }
  for (i = start; i <= length(s); i++) {
    ch = substr(s, i, 1)
    if (quote != "" && ch == quote) { quote = ""; continue }
    if (quote != "")                { out = out ch; continue }
    if (ch == "#" && (i == start || substr(s, i - 1, 1) ~ /[ \t]/)) break
    out = out ch
  }
  sub(/[ \t]+$/, "", out)
  return out
}
'

# One scalar out of an item's frontmatter.
fm() {
  [ -n "$1" ] || return 0
  awk -v key="$2" "$DECOMMENT"'
    NR == 1 && /^---$/ { fm = 1; next }
    fm && /^---$/ { exit }
    fm && $0 ~ "^" key ":" { sub("^" key ": *", ""); print decomment($0); exit }
  ' "$1"
}

# One frontmatter list, flattened to a line: inline `["0010"]` or a block of `- ` entries.
#
# Entries may carry YAML comments, because `develop` Step 1 tells a session to declare a file it is
# about to create and say inline that it is new. A comment returned as part of an entry is not
# cosmetic: these lists are what the scope-overlap check compares, so prose in the list reads as a
# claimed path and a trailing space makes a real collision compare unequal — it fails open, and both
# windows land in one file. `decomment` is defined once, above.
fm_list() {
  [ -n "$1" ] || return 0
  awk -v key="$2" "$DECOMMENT"'
    NR == 1 && /^---$/ { fm = 1; next }
    fm && /^---$/ { exit }
    fm && $0 ~ "^" key ":" {
      rest = $0; sub("^" key ": *", "", rest)
      rest = decomment(rest)
      if (rest ~ /\[/) { gsub(/[][",]/, " ", rest); printf "%s", rest; exit }
      inside = 1; next
    }
    # A comment on its own line is skipped rather than ending the block. Falling through to the
    # `exit` below would silently truncate the list at the note, which is worse than printing it.
    inside && /^[ \t]*#/ { next }
    inside && /^  *- / {
      sub(/^ *- */, "")
      entry = decomment($0)
      if (entry != "") printf "%s ", entry
      next
    }
    inside { exit }
  ' "$1"
}

# An entry in `blocked_by` is OPEN unless the ticket it names is done. A named ticket with no item
# file is open and said so out loud: a blocker nobody can find is not a blocker anybody cleared.
open_blockers_of() {
  bl="$(fm_list "$(item_for "$1")" blocked_by)"
  for b in $bl; do
    bi="$(item_for "$b")"
    if [ -z "$bi" ]; then printf '%s(no item file) ' "$b"; continue; fi
    [ "$(fm "$bi" status)" = "done" ] || printf '%s ' "$b"
  done
}

# `blocked` is derived, never authored: a row is blocked if and only if `blocked_by` names at least
# one ticket that is not done. The Status column caches that answer and nothing kept the cache in
# step — a ticket closed and four rows naming it stayed `blocked` for the rest of a session. So
# every read here asks the graph, and `--drift` reports the cache lines that have gone stale.
derived_of() {
  if [ -n "$(open_blockers_of "$1")" ]; then printf 'blocked'; else printf 'ready'; fi
}

# Who holds a ticket. `references/CONCURRENCY.md`, *A stage writes only the ticket it holds*, owns
# the definition and it is not restated here; this is the one implementation of it, and every
# ownership question in this script routes through it — the take loop, the `--drive` walk, the
# CLAIMED FILES block, the collision report and `--drift`'s two ownership classes.
#
# Ownership is a property of the ITEM, so the Status column is a cache of it exactly as it is a
# cache of `blocked`, and `--drift` reports the cache lines that have gone stale in both directions.
#
# Prints the token and returns 0 when held; prints nothing and returns 1 when not. The `hb_`
# prefixes matter: sh has no locals, and two of the callers below loop over `it` and `tok`.
held_by() {
  hb_it="$(item_for "$1")"
  [ -n "$hb_it" ] || return 1
  hb_tok="$(fm "$hb_it" claimed_by)"
  [ -n "$hb_tok" ] || return 1
  printf '%s' "$hb_tok"
}

# The first line of an item's `## Waiting on` section — the question, without opening the ticket.
waiting_on() {
  [ -n "$1" ] || return 0
  awk '
    /^## Waiting on/ { inside = 1; next }
    inside && /^## / { exit }
    inside && NF { print; exit }
  ' "$1"
}

# The first line of an item's `## Open design question` section — what `--drive` carries to a person
# when a row is at `next: design`, so they answer in one line rather than opening the ticket.
design_question() {
  [ -n "$1" ] || return 0
  awk '
    /^## Open design question/ { inside = 1; next }
    inside && /^## / { exit }
    inside && NF { print; exit }
  ' "$1"
}

# The first line of an item's `## Problem` section, which is what a proposal shows a person as the
# work (0130 FR4: drawn from the ticket rather than invented). Emphasis is stripped because these
# lines are almost always written `**bolded like this**, and then continued`, and the asterisks are
# markup for a file nobody is reading here. Truncated, because one ticket's opening sentence is not
# allowed to set the width of a forty-row proposal.
problem_line() {
  [ -n "$1" ] || return 0
  awk '
    /^## Problem/ { inside = 1; next }
    inside && /^## / { exit }
    # The first PARAGRAPH, flattened — never the first source line. These sections are wrapped
    # prose, so a line is a typographic accident: the live backlog produced "…is invisible to the
    # only reader that is", cut mid-clause at the wrap. Flatten, then truncate on a width this
    # function chooses.
    inside && NF { para = (para == "" ? $0 : para " " $0); next }
    inside && para != "" { exit }
    END {
      gsub(/\*\*/, "", para)
      gsub(/[ \t]+/, " ", para)
      sub(/^ /, "", para); sub(/ $/, "", para)
      if (para == "") exit
      if (length(para) > 140) para = substr(para, 1, 139) "…"
      print para
    }
  ' "$1"
}

# --- shared tails -----------------------------------------------------------------------------
# Is $1 one of the space-separated words in $2? The padding is what makes it exact — without it
# `docs/a` matches `docs/ab`. Ids and the paths in `expects:` carry no whitespace, which is what
# lets every list in this script be space-separated in the first place.
contains_word() {
  case " $2 " in *" $1 "*) return 0 ;; esac
  return 1
}

# Every path in $1 that is also in $2, in $1's order. `--drive` asks only whether the two lists
# meet; the take loop has to name which paths did, because a collision reported without its path
# is a verdict the reader cannot check (0045 FR3).
paths_shared() {
  for pa in $1; do
    if contains_word "$pa" "$2"; then printf '%s ' "$pa"; fi
  done
}

paths_overlap() {
  [ -n "$(paths_shared "$1" "$2")" ]
}


# An uncommitted queue is a claim only one session can see: whoever commits QUEUE.md next carries
# these rows under their own message, and the first anyone notices is a confusing diff.
warn_dirty() {
  # **Pathspec here is relative to `$DIR`, deliberately — do not "tidy" it back to `$QUEUE`.** It is
# absolute, and on a case-insensitive filesystem `$DIR` can spell the repo path in a different case
# from `git rev-parse --show-toplevel`, which makes an absolute pathspec read as *outside the repo*.
# With a single pathspec there is no second file to compare against, so the check degrades to a
# silent pass instead of a loud wrong answer — the direction that loses work rather than time.
if git -C "$DIR" rev-parse --git-dir >/dev/null 2>&1 && ! git -C "$DIR" diff --quiet -- QUEUE.md; then
    printf 'WARNING: QUEUE.md has uncommitted row changes — commit yours now, and do not commit rows\n'
    printf '         you did not claim (references/CONCURRENCY.md). Changed rows:\n'
    git -C "$DIR" diff -U0 -- QUEUE.md | awk -F'|' -v s="$STATUS" -v n="$NEXT" '
      /^[+-]\| / {
        id = $2; gsub(/^[+-] *| *$/, "", id)
        nx = $n; gsub(/^ +| +$/, "", nx)
        st = $s; gsub(/^ +| +$/, "", st)
        printf "         %s %s | %s | %s\n", substr($0, 1, 1), id, nx, st
      }'
  fi
}

# The best available description of a held row's file scope. `touches:` was checked against the
# code; `expects:` is the prediction the ticket was written with and is labelled as such — the
# reader is being handed a weaker answer, not a narrower claim, and still has to ask.
#
# $1 the held item file.
declared_scope() {
  tou="$(fm_list "$1" touches)"
  [ -z "$tou" ] || { printf '%s' "$tou"; return 0; }
  pred="$(fm_list "$1" expects)"
  [ -n "$pred" ] || { printf 'none declared — assume held, ask'; return 0; }
  printf 'none declared; predicted by expects: %s — assume held, ask' "${pred% }"
}

# Files another session holds. This is the check that stops two windows in one file, and it is why
# the script reads item frontmatter rather than only the table: `touches:` is a claim on files.
# The set is every HELD row, in rank order — not every row the column calls `in-progress` (0140).
# A row reading `ready` over a held item was omitted from this block entirely, which is the one
# place a reader could have seen the claim; a row reading `in-progress` over a tokenless item was
# listed as `[no token]`, which reads as a claim where `--drift` calls it drift.
show_claimed() {
  busy=""
  for cid in $(all_ids); do
    ctok="$(held_by "$cid")" || continue
    # An empty `touches:` here is ambiguous — not yet declared, or released as the row closes — and
    # nothing can tell them apart, so `declared_scope` says so rather than implying the row is free.
    busy="$busy  $cid [$ctok] $(declared_scope "$(item_for "$cid")")
"
  done
  [ -n "$busy" ] || return 0
  printf 'CLAIMED FILES — another session owns these; take a row that avoids them:\n'
  printf '%s' "$busy"
}

# Which held rows hold a file this candidate's `expects:` names, and which files those are.
# One line per colliding row, already worded for the report: a collision stated without its path is
# a verdict the reader cannot check, and without its holder there is nobody to ask (0045 FR3).
#
# `touches:` only. That is the claim a session made against the code, where a held row's `expects:`
# was written before anyone opened the file — the CLAIMED FILES block below carries the weaker
# field for a reader to judge, and a prediction is not a thing to refuse a row over.
#
# Not filtered by stage: the instance that cost the most was a `develop` row colliding with a live
# `verify` claim, and that one is the worse case — a QA session runs the suite while the files
# under it are edited, so its verdict describes a tree that was never a commit (0045 FR6).
#
# Empty when the candidate is clear, which is also how the caller asks the question.
#
# $1 the candidate's id, $2 its `expects:` list.
collision_report() {
  for hid in $(all_ids); do
    htok="$(held_by "$hid")" || continue
    htouches="$(fm_list "$(item_for "$hid")" touches)"
    # An EXCLUSIVE CLAIM — `touches: "*"` — holds the whole tree, so it collides with every
    # candidate rather than with the ones naming a path it happens to share (0067 FR5;
    # `CONCURRENCY.md`, *A change that touches every file takes an exclusive claim*). Tested BEFORE
    # `paths_shared`, which matches path words exactly and so intersects `*` with nothing at all —
    # which is how a cross-cutting rename came to be invisible to the one mechanism that reports
    # scope. It has to short-circuit for a second reason: a candidate whose own `expects:` is empty
    # has no path to intersect, so no intersection filter, however wide the holder's side, can ever
    # report it.
    #
    # Only from a HELD row, which `held_by` above already decides. A stale `"*"` left on an unheld
    # row must collide with nothing, or one un-stripped field freezes the stage for everyone.
    if contains_word '*' "$htouches"; then
      printf 'COLLIDES  %s | every file — exclusive claim held by %s [%s]\n' "$1" "$hid" "$htok"
      continue
    fi
    shared="$(paths_shared "$2" "$htouches")"
    [ -n "$shared" ] || continue
    printf 'COLLIDES  %s | %s — held by %s [%s]\n' "$1" "${shared% }" "$hid" "$htok"
  done
}

# --- --waiting --------------------------------------------------------------------------------
# A `waiting` row says a person is needed and not what for. Without this, finding out means opening
# the ticket — the exact cost the pared table exists to remove.
if [ "${1:-}" = "--waiting" ]; then
  bad=0
  any=0
  for id in $(ids_where "$STATUS" waiting); do
    any=1
    row="$(row_for "$id")"
    q="$(waiting_on "$(item_for "$id")")"
    if [ -n "$q" ]; then
      printf 'WAITING   %s | %s\n          %s\n' "$id" "$(field "$row" "$TITLE")" "$q"
    else
      # Reported as a defect in the row, never skipped: a `waiting` row with no question is
      # indistinguishable from a forgotten one, and only the person named can clear either.
      printf 'MALFORMED %s | %s\n          status is waiting with no "## Waiting on" section\n' \
        "$id" "$(field "$row" "$TITLE")"
      bad=1
    fi
  done
  [ "$any" -eq 1 ] || printf 'nothing is waiting on a person\n'
  exit "$bad"
fi

# --- --drift ----------------------------------------------------------------------------------
# A row and the item behind it are two records of one ticket, and only one of them is authoritative
# on each field. This names every row where the two disagree, so the staleness is visible without
# opening a ticket. Five classes, and this comment is the one place they are listed — `usage()`
# names them in a line, and the prose that cites this mode cites the contract rather than copying
# it (0115 FR6):
#
#   1. no item file resolves for the row                        — checked first, because every read
#      below returns empty against a missing file and would present as a disagreement with ""
#   2. the Status column against `blocked_by`, in both directions — the cache 0024 built this for
#   3. the Next column against the item's `next:`                — a half-applied hand-off
#   4. the Status column against the item's `status:`            — the other half of the same
#   5. a row at `in-progress` over an unheld item                — drift, not ownership, per
#      CONCURRENCY.md's *A stage writes only the ticket it holds*, which owns the definition of
#      *held*; distinct from 4 because both records can read `in-progress` with nobody holding the
#      ticket
#   6. a row NOT at `in-progress` over a HELD item                — the mirror of 5, and the
#      direction that loses work rather than time: the row reads takeable while somebody is
#      building it (0140). Reported last of the six so a row disagreeing on `status:` as well is
#      one line, class 4's, rather than two
#
# One line per row, the classes in that order: a second line about the same row is noise, and the
# stale `blocked` cache is the more actionable reading whenever it and 4 both fire. It exits
# non-zero on any drift: a report that prints and exits zero is invisible to anything scripted
# around it, which is the same silent failure it exists to remove. Nothing here writes —
# reconciling belongs to whatever closed the blocker or left the hand-off half-applied.
#
# A FUNCTION, and shared with `--drive` rather than restated there (0142 FR3). Two copies of the
# class list is the defect 0115 and 0141 each recorded once already: the second copy is written
# from the first and then diverges silently, because nothing reds when one of them stops naming a
# class. Prints one line per drifted row and returns 1 if any drifted, 0 if none — the return is
# the report's verdict, so a caller that only wants the verdict discards the output rather than
# re-deriving it. `dr_` prefixes because sh has no locals and both callers loop over `id`.
drift_report() {
  dr_drifted=0
  for dr_id in $(all_ids); do
    id="$dr_id"
    row="$(row_for "$id")"
    written="$(field "$row" "$STATUS")"
    derived="$(derived_of "$id")"
    item="$(item_for "$id")"

    # Only `blocked` is derived. `waiting` is cleared by a person and `in-progress` by a claim, so
    # neither can drift against the graph — but a row sitting at either WITH an open blocker is
    # still a lie about takeability, and that direction is reported.
    if [ -z "$item" ]; then
      printf 'DRIFT     %s | row present, no item file — items/%s-*.md resolves to nothing\n' "$id" "$id"
      dr_drifted=1
    elif [ "$written" = "blocked" ] && [ "$derived" = "ready" ]; then
      printf 'DRIFT     %s | written blocked, derived ready — no blocked_by entry is still open\n' "$id"
      dr_drifted=1
    elif [ "$written" != "blocked" ] && [ "$derived" = "blocked" ]; then
      printf 'DRIFT     %s | written %s, derived blocked — blocked_by still open: %s\n' \
        "$id" "$written" "$(open_blockers_of "$id")"
      dr_drifted=1
    elif [ "$(field "$row" "$NEXT")" != "$(fm "$item" next)" ]; then
      printf 'DRIFT     %s | row Next %s, item next: %s — the row and its item disagree about the stage\n' \
        "$id" "$(field "$row" "$NEXT")" "$(fm "$item" next)"
      dr_drifted=1
    elif [ "$written" != "$(fm "$item" status)" ]; then
      printf 'DRIFT     %s | row Status %s, item status: %s — the row and its item disagree about the status\n' \
        "$id" "$written" "$(fm "$item" status)"
      dr_drifted=1
    elif [ "$written" = "in-progress" ] && ! held_by "$id" >/dev/null; then
      printf 'DRIFT     %s | row Status in-progress, item claimed_by: empty — nobody holds it\n' "$id"
      dr_drifted=1
    elif [ "$written" != "in-progress" ] && dtok="$(held_by "$id")"; then
      printf 'DRIFT     %s | row Status %s, item claimed_by: %s — held, and the row does not say so\n' \
        "$id" "$written" "$dtok"
      dr_drifted=1
    fi
  done
  return "$dr_drifted"
}

if [ "${1:-}" = "--drift" ]; then
  if drift_report; then
    printf 'no drift: every row agrees with its blocked_by and with its item\n'
    exit 0
  fi
  exit 1
fi

# --- --drive ----------------------------------------------------------------------------------
# What should happen next, for a driver rather than a human. FR8 of 0038 is the specification: the
# whole space of transitions the three stages can write, each routed, and anything outside it stops
# rather than falling through to a default.
#
# Two things make this a different question from `./next <stage>`, and neither is cosmetic:
#
#   - It spends a distinct code per outcome. `./next develop` spends 0 on both "here is a row" and
#     "nothing is takeable" — a human reading the line gets away with that, a loop cannot.
#   - It takes the completed outcome as an INPUT (`--completed`) rather than deriving it. A driver
#     killed after dispatch but before the stage claimed leaves the row `ready`, so a stateless
#     re-derivation has to re-dispatch it; a guard keyed on "same ticket, same stage" alone would
#     escalate that recovery. The guard needs an intervening outcome, and only the caller's run log
#     holds one. Absent it, `--drive` dispatches.
#
# The Status COLUMN is the authority for routing, deliberately, because there are two vocabularies:
# item frontmatter also carries `active` (a project, which has no row) and `done` (a closed ticket).
# Frontmatter stays the authority for everything else — `parent:`, `expects:`, the two sections.
#
# Nothing here writes, takes the lock, or acts. It prints one decision.
if [ "${1:-}" = "--drive" ]; then
  # The four outcomes, named because a bare `decide 3` where `decide 4` was meant is a silent
  # routing bug: a driver reads "run complete" and stops instead of asking a person. `--help`
  # publishes the same numbers — that block and these four lines are the contract.
  DISPATCH=0
  RUN_COMPLETE=3
  ESCALATE=4
  FINDINGS_GATE=5

  read_threshold || exit 1
  read_max_sprints || exit 1
  shift
  COMPLETED=""
  STARTED=""
  PROPOSE=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --propose) PROPOSE=1; shift ;;
      --completed)
        shift
        [ $# -gt 0 ] || { echo "--completed needs <stage>[:<id>]" >&2; usage >&2; exit 2; }
        # One only, and it stays that way (0131 FR8). The guard below needs *an* intervening
        # outcome, not a history, so accepting a list while reading a single element is a trap for
        # the caller. What a run's history is for is the finish-before-start preference, and that
        # is `--started`: a different fact with a different lifetime — "what just finished" is
        # per-call and transient, "what this run has opened" is cumulative and monotonic.
        [ -z "$COMPLETED" ] || { echo "--completed takes one <stage>[:<id>]; got a second: $1" >&2; exit 2; }
        COMPLETED="$1"
        shift ;;
      --started)
        shift
        [ $# -gt 0 ] || { echo "--started needs <id>" >&2; usage >&2; exit 2; }
        # Four digits or a usage error. A malformed id matches no row and would disable the
        # preference in silence, which is the one failure mode a fail-open rule may not have.
        case "$1" in
          [0-9][0-9][0-9][0-9]) : ;;
          *) echo "--started takes a four-digit id; got: $1" >&2; usage >&2; exit 2 ;;
        esac
        contains_word "$1" "$STARTED" || STARTED="$STARTED $1"
        shift ;;
      *) echo "unknown argument to --drive: $1" >&2; usage >&2; exit 2 ;;
    esac
  done

  # A started id with no row is ordinary: the ticket closed, or gained a child and became a
  # project. An id with no row AND no item file is a driver bug, and it is reported rather than
  # swallowed — the preference silently stopping applying is worse than the run stopping, and both
  # are worse than one line naming the id (references/CONVENTIONS.md, the fail-open ladder).
  for sid in $STARTED; do
    if [ -z "$(row_for "$sid")" ] && [ -z "$(item_for "$sid")" ]; then
      printf 'NOTE      --started %s matches no row and no item file — nothing recognises that id\n' "$sid"
    fi
  done

  # Every takeable `next: develop` row, in rank order — the same predicate `./next develop` applies.
  takeable_develop() {
    for tid in $(all_ids); do
      trow="$(row_for "$tid")"
      if [ "$(field "$trow" "$NEXT")" != "develop" ]; then continue; fi
      case "$(field "$trow" "$STATUS")" in in-progress|waiting) continue ;; esac
      if held_by "$tid" >/dev/null; then continue; fi
      if [ -n "$(open_blockers_of "$tid")" ]; then continue; fi
      printf '%s ' "$tid"
    done
  }

  # $1 minus $2. sh has no set type, so the difference is a loop rather than an operator.
  without() {
    for wid in $1; do
      if ! contains_word "$wid" "$2"; then printf '%s ' "$wid"; fi
    done
  }

  # The gate led by $1 out of the pool $2: the lead, plus every other takeable develop row sharing
  # its parent or naming one of the same files in `expects:`. That is `develop`'s own batching unit
  # — the unit is a gate, not a row, because what batching saves is the startup a session pays
  # before it writes a line, and that is only shared where the parent or the files are.
  #
  # Membership is tested against the gate's ACCUMULATED scope — the union of the `expects:` of every
  # row already in it — not against the lead's alone (0136). Against the lead alone the gates this
  # walk produces are not guaranteed disjoint from each other: a row can be excluded from gate 1 for
  # not overlapping its lead while naming a file some other member of gate 1 does name, and then
  # lead a gate 2 that collides with it. That miscounts DEPTH today and is a live hazard the moment
  # anything dispatches two gates at once.
  #
  # Two bounds hold that chaining down, and they have to be read together with the hazard above:
  #
  #  - **One pass over the pool, in rank order, each row tested exactly once and never reconsidered.**
  #    So the scope only ever grows forward: a row stepped over is not pulled back in by a later
  #    member that happens to name one of its files. This is not the transitive closure of the
  #    shared-file graph, which is what would sweep half a backlog into one gate via a file two
  #    unrelated efforts both happen to touch.
  #  - **The pool is the takeable `develop` rows only**, so nothing blocked, held or at another
  #    stage can extend the scope.
  #
  # A gate can still grow long where a chain of rows really does share files pairwise; that group is
  # genuinely one file scope and cannot be split into sessions that run together. Making the
  # composition legible to a person is 0130's.
  gate_from() {
    lead="$1"; pool="$2"
    lparent="$(fm "$(item_for "$lead")" parent)"
    gscope="$(fm_list "$(item_for "$lead")" expects)"
    printf '%s' "$lead"
    for gid in $pool; do
      if [ "$gid" = "$lead" ]; then continue; fi
      gexpects="$(fm_list "$(item_for "$gid")" expects)"
      if [ -n "$lparent" ] && [ "$(fm "$(item_for "$gid")" parent)" = "$lparent" ]; then
        gscope="$gscope $gexpects"
        printf ' %s' "$gid"; continue
      fi
      if paths_overlap "$gscope" "$gexpects"; then
        gscope="$gscope $gexpects"
        printf ' %s' "$gid"
      fi
    done
  }

  # What the walk would halt on after every takeable gate is spent. Without this a driver's first
  # run stops at the first `next: design` row and reads as broken rather than as finished.
  depth_stopper() {
    for sid in $(all_ids); do
      srow="$(row_for "$sid")"
      snext="$(field "$srow" "$NEXT")"
      sstatus="$(field "$srow" "$STATUS")"
      if [ "$sstatus" = "in-progress" ]; then continue; fi
      if [ -n "$(open_blockers_of "$sid")" ]; then continue; fi
      if held_by "$sid" >/dev/null; then continue; fi
      if [ "$sstatus" = "waiting" ]; then printf '%s (waiting on a person)' "$sid"; return 0; fi
      case "$snext" in
        design|queue)   printf '%s (next: %s — a person decides)' "$sid" "$snext"; return 0 ;;
        develop|verify) continue ;;
        *)              printf "%s (next: '%s' — no routing rule covers it)" "$sid" "$snext"; return 0 ;;
      esac
    done
    printf 'the end of the queue'
  }

  # FR17: one read answers both "what now" and "how far does this go", because the read happens
  # anyway. Gates, not rows — two rows that batch are one session.
  depth_line() {
    remaining="$(takeable_develop)"
    gates=0
    while [ -n "$remaining" ]; do
      taken="$(gate_from "$(printf '%s' "$remaining" | awk '{ print $1 }')" "$remaining")"
      gates=$((gates + 1))
      remaining="$(without "$remaining" "$taken" | awk '{ $1 = $1; print }')"
    done
    printf 'DEPTH     %s develop gate(s) takeable; runs dry at %s\n' "$gates" "$(depth_stopper)"
  }

  # What `--propose` describes, set at each dispatch site and read by `decide`. Two variables
  # rather than an argument to `decide`, because every non-dispatch decision would otherwise have
  # to pass two empty strings past a reader who never wants them.
  PROPOSE_STAGE=""
  PROPOSE_IDS=""

  # The gate, made legible before a person approves it (0130). Printed between the depth line and
  # the decision, so a reader meets the shape of the run and then the instruction.
  #
  # WHAT THIS IS FOR, in one sentence, because the block reads like a report and is not one: a gate
  # is a CONFLICT unit, and presenting a conflict unit as a plan is how a person approves thirteen
  # tickets meaning to approve four. The JOIN lines are the whole point — a count alone reads as a
  # large sprint, where "ten of these are here because they all edit one file" reads as the grouping
  # artefact it is, and only the second is something a person can act on.
  #
  # A file NAMED BY ONE ROW IS NOT PRINTED. It explains no grouping, and a one-row coincidence
  # listed beside a real hub invites reading it as a theme.
  #
  # How many shared files are listed before the rest are counted in one line. Five because the
  # question a person is answering is "is this one effort or several", and the files explaining the
  # largest shares are what answer it; the long tail of pairs is what buried the answer on the live
  # backlog. A figure, not a judgement call, so the block's length is bounded by the gate's shape
  # and never by how verbose its tickets are.
  PROPOSE_JOIN_CAP=5

  # `pb_` prefixes because sh has no locals, and this script's own `held_by` records why that
  # matters: `paths_shared` loops over a bare `pa`, so a future call to it from inside this block
  # would corrupt the loop it was called from, silently.
  propose_block() {
    [ "$PROPOSE" = 1 ] || return 0
    [ -n "$PROPOSE_STAGE" ] || return 0

    pb_n=0
    for pb_id in $PROPOSE_IDS; do pb_n=$((pb_n + 1)); done

    # `retro` is dispatched by the findings gate and holds no row. It is still a stage session, so
    # it is still something a person is being asked to approve — a stage that silently skipped the
    # proposal would be the one hole in "no stage runs unconfirmed".
    if [ "$pb_n" = 0 ]; then
      printf 'PROPOSE   %s | no ticket of its own — the findings buffer is the subject\n' "$PROPOSE_STAGE"
      return 0
    fi

    printf 'PROPOSE   %s | %s ticket(s)\n' "$PROPOSE_STAGE" "$pb_n"
    for pb_id in $PROPOSE_IDS; do
      pb_item="$(item_for "$pb_id")"
      printf 'TICKET    %s | size %s | %s\n' "$pb_id" "$(fm "$pb_item" size)" "$(field "$(row_for "$pb_id")" "$TITLE")"
      pb_work="$(problem_line "$pb_item")"
      [ -z "$pb_work" ] || printf 'WORK      %s\n' "$pb_work"
    done

    # One `fm_list` per ticket rather than one per (ticket, path) pair: the counting is awk's, so a
    # forty-row gate naming a hundred and sixty paths stays forty reads rather than six thousand.
    # A row naming the same path twice counts once — `expects:` is a set, and a duplicated entry
    # would otherwise inflate the very number a person is being asked to judge.
    for pb_id in $PROPOSE_IDS; do
      for pb_path in $(fm_list "$(item_for "$pb_id")" expects); do printf '%s %s\n' "$pb_path" "$pb_id"; done
    done | awk -v n="$pb_n" -v cap="$PROPOSE_JOIN_CAP" '
      !($1 SUBSEP $2 in pair) {
        pair[$1 SUBSEP $2] = 1
        if (!($1 in count)) { path[++k] = $1 }
        count[$1]++
      }
      END {
        # Ranked by how much of the gate each file explains, so the hub a person needs to see is
        # the first line rather than wherever the lead happened to name it. Selection sort: k is
        # the number of distinct paths in one gate, and a sort utility is a process.
        for (i = 1; i <= k; i++) {
          top = i
          for (j = i + 1; j <= k; j++) if (count[path[j]] > count[path[top]]) top = j
          swap = path[i]; path[i] = path[top]; path[top] = swap
        }
        # Capped, and the tail COUNTED rather than dropped. 34 join lines over a 41-row gate is the
        # unreadable thing FR5 removes, arriving one level down — and a block that silently stops
        # listing is a proposal whose numbers cannot be reconciled against the gate it describes.
        for (i = 1; i <= k; i++) {
          if (count[path[i]] < 2) continue
          shared++
          if (shared <= cap)
            printf "JOIN      %s | %d of %d rows join through this file\n", path[i], count[path[i]], n
        }
        if (shared > cap)
          printf "JOIN      %d further file(s) shared by 2 or more rows, not listed\n", shared - cap
      }
    '

    # The gate's OTHER join mechanism. `gate_from` batches on a shared `parent:` as well as on a
    # shared file, so a proposal explaining only the files mislabels a row that joined by slice as
    # unexplained — and that row is the one a person is most likely to think was included by mistake.
    for pb_id in $PROPOSE_IDS; do fm "$(item_for "$pb_id")" parent; done | awk -v n="$pb_n" '
      NF { if (!($0 in count)) { par[++k] = $0 } ; count[$0]++ }
      END {
        for (i = 1; i <= k; i++)
          if (count[par[i]] >= 2)
            printf "JOIN      parent %s | %d of %d rows share this parent slice\n", par[i], count[par[i]], n
      }
    '
  }

  # $1 the exit code, $2 the decision. The depth line goes out with every decision, never on its own
  # invocation — that second read is the cost FR17 exists to avoid.
  decide() {
    depth_line
    propose_block
    printf '%s\n' "$2"
    exit "$1"
  }

  # Checked where a NEW gate would be dispatched, and not before a verify: a ticket already built is
  # finished rather than abandoned for a retro. Evaluating the gate once per run is 0039's.
  findings_gate() {
    read_tools_buffer
    [ -f "$FINDINGS" ] || [ -n "$TOOLS_FINDINGS" ] || return 0
    # The same tally the `--findings` line prints (0060 FR10). A driver routing on one number while
    # the human beside it reads another is the divergence this gate exists to prevent, not to add.
    tally_findings
    if [ "$FBAD" != 0 ]; then
      decide "$ESCALATE" "ESCALATE  FINDINGS.md carries an entry shape the count does not recognise, so the gate cannot be trusted — and a gate reading a low number fires late and silently"
    fi
    tally_age
    # The provenance clause rides along only where a SECOND buffer was counted: where the total is
    # the local buffer alone, the original sentence already says everything a driver acts on.
    gsrc=""
    [ -z "$TOOLS_FINDINGS" ] || gsrc="; $(findings_sources)"
    # TWO LIMITS, WHICHEVER COMES FIRST (0133 FR2), and the line says WHICH crossed — a driver that
    # cannot tell volume from time served cannot report why it spent a tail.
    #
    # THE TAIL IS `retro` AND THEN `queue`. Naming only the retro is 0060's asymmetry arriving as a
    # dispatch: retro lands the lesson halves and only a queue sweep can take the work halves, so a
    # gate that dispatches one of the two leaves the buffer holding what it came to clear.
    if [ "$FCOUNT" -ge "$THRESHOLD" ]; then
      PROPOSE_STAGE="retro"; PROPOSE_IDS=""
      decide "$FINDINGS_GATE" "DISPATCH  retro, then queue — FINDINGS.md holds $FCOUNT entries against a threshold of $THRESHOLD$gsrc"
    fi
    if age_gate_crossed; then
      PROPOSE_STAGE="retro"; PROPOSE_IDS=""
      decide "$FINDINGS_GATE" "DISPATCH  retro, then queue — FINDINGS.md holds $FCOUNT entries whose oldest ($FOLDEST) has survived $FAGE completed sprint(s) against a limit of $MAX_SPRINTS$gsrc"
    fi
  }

  # The highest-ranked row this RUN started that is still sitting at `verify | ready`, or nothing.
  #
  # Why it is scoped to the run's own tickets (0131 FR5): a ticket left at `next: verify` by a
  # hand-driven session before this run began is not this run's to hold, and jumping the rank for
  # it would let unrelated stale work reorder every run. The set is an INPUT and never derived from
  # `parent:` or `expects:` — deriving it re-admits exactly what the scoping forbids, a stale
  # verify row reordering the run because it happens to name one of the same files.
  #
  # Rank still decides among the candidates: the walk is `all_ids`, so the ids' arrival order on
  # the command line means nothing. `sv_` prefixes because sh has no locals.
  started_verify() {
    for sv_id in $(all_ids); do
      contains_word "$sv_id" "$STARTED" || continue
      sv_row="$(row_for "$sv_id")"
      [ "$(field "$sv_row" "$NEXT")" = "verify" ] || continue
      [ "$(field "$sv_row" "$STATUS")" = "ready" ] || continue
      if held_by "$sv_id" >/dev/null; then continue; fi
      if [ -n "$(open_blockers_of "$sv_id")" ]; then continue; fi
      printf '%s' "$sv_id"
      return 0
    done
    return 1
  }

  # --- the queue has to agree with itself before anything is dispatched ------------------------
  # FR1/FR2 of 0142. `--drift` exits non-zero on every class precisely so that a row disagreeing
  # with its own item stops the work, and until this landed the only reader that saw that exit was
  # a person running the mode by hand: `--drive`'s body carried no drift check, so a drifted
  # backlog read as a FINISHED one to a driver. Measured on the 0084 shape — `--drift` exited 1
  # while `--drive` printed `COMPLETE nothing takeable` and exited 3 over the same queue.
  #
  # FIRST, and before the walk, because that ordering IS the requirement: run it after the
  # takeability walk and a queue with drift and nothing takeable reaches COMPLETE and exits 3 with
  # the drift never printed, which is the bug rather than the fix.
  #
  # It spends ESCALATE rather than a sixth code. The outcome is *a person decides* — reconciling a
  # row against its item is not a stage's to do, and `sprint` already routes 4 exactly that
  # way. 3 is forbidden: 3 is what the bug is.
  if ! drift_report; then
    decide "$ESCALATE" "ESCALATE  the rows above disagree with their own items — a drifted queue is not a finished one, and reconciling it is a person's call"
  fi

  # --- what the caller says just finished -----------------------------------------------------
  # Order matters here and is not alphabetical. `waiting`, `design` and `queue` are checked before
  # the same-stage guard, because develop writing any of those leaves the row where it was and the
  # specific reason is the thing a person needs. An acquired blocker is checked before it too: that
  # one is not stuck at all, it is re-derivable.
  last=""
  for c in $COMPLETED; do last="$c"; done
  if [ -n "$last" ]; then
    lstage="${last%%:*}"
    lid="${last#*:}"
    if [ "$lid" = "$lstage" ]; then lid=""; fi
    if [ -z "$lid" ]; then
      printf 'NOTE      %s finished with no ticket of its own — choosing the next gate\n' "$lstage"
    else
      lrow="$(row_for "$lid")"
      if [ -z "$lrow" ]; then
        # A row leaving QUEUE.md is two different events and only one of them is a close. A ticket
        # becomes a project the moment it gains a child, and its row leaves — not an error, and not
        # something to loop on.
        if [ -f "$DONE" ] && [ -n "$(awk -F'|' -v id="$lid" '/^\|/ { v = $2; gsub(/^ +| +$/, "", v); if (v == id) { print; exit } }' "$DONE")" ]; then
          printf 'NOTE      %s closed and left QUEUE.md — choosing the next gate\n' "$lid"
        elif [ -n "$(item_for "$lid")" ]; then
          printf 'NOTE      %s has an item but no row — a ticket that became a project; not an error and not a loop\n' "$lid"
        else
          decide "$ESCALATE" "ESCALATE  $lid has no row in QUEUE.md and no item file — nothing recognises that state"
        fi
      else
        lnext="$(field "$lrow" "$NEXT")"
        lstatus="$(field "$lrow" "$STATUS")"
        lblockers="$(open_blockers_of "$lid")"
        if [ "$lstatus" = "waiting" ]; then
          decide "$ESCALATE" "ESCALATE  $lid is waiting on a person after $lstage — only they can clear it
          $(waiting_on "$(item_for "$lid")")"
        elif [ "$lstatus" = "in-progress" ]; then
          decide "$ESCALATE" "ESCALATE  $lid is still in-progress after $lstage completed — the claim was never released"
        elif [ "$lnext" = "design" ]; then
          decide "$ESCALATE" "ESCALATE  $lid is at next: design after $lstage — a person decides
          $(design_question "$(item_for "$lid")")"
        elif [ "$lnext" = "queue" ]; then
          decide "$ESCALATE" "ESCALATE  $lid went back to next: queue after $lstage — the contract is stale, and respecifying it is a person's call"
        elif [ -n "$lblockers" ]; then
          printf 'NOTE      %s gained a blocker after %s (%s) — re-deriving rather than reading it as stuck\n' \
            "$lid" "$lstage" "$lblockers"
        elif [ "$lstage" = "verify" ] && [ "$lnext" = "develop" ]; then
          decide "$ESCALATE" "ESCALATE  $lid bounced from verify back to next: develop — verify already decided whether the build or the contract was wrong, and re-developing blind spends a stage session rediscovering it"
        elif [ "$lnext" = "$lstage" ]; then
          decide "$ESCALATE" "ESCALATE  $lid is still at next: $lstage after a completed $lstage — same ticket, same stage, with an outcome in between"
        elif [ "$lstage" = "develop" ] && [ "$lnext" = "verify" ] && [ "$lstatus" = "ready" ]; then
          PROPOSE_STAGE="verify"; PROPOSE_IDS="$lid"
          decide "$DISPATCH" "DISPATCH  verify $lid"
        else
          decide "$ESCALATE" "ESCALATE  $lid is at next: $lnext / $lstatus after $lstage, which no routing rule covers"
        fi
      fi
    fi
  fi

  # `--completed`'s id is a ticket this run opened work on too, so it joins the started set
  # (0131 FR6). That is what lets a run whose gates are all single tickets pass no `--started` at
  # all: the flag it already sends carries the same fact for the one ticket it names.
  if [ -n "$COMPLETED" ]; then
    cid="${COMPLETED#*:}"
    if [ "$cid" != "$COMPLETED" ] && [ -n "$cid" ]; then
      contains_word "$cid" "$STARTED" || STARTED="$STARTED $cid"
    fi
  fi

  # --- otherwise, walk the rank ---------------------------------------------------------------
  # Line order is the rank and the rank is absolute, so the first row anything can act on decides.
  # `blocked` and `in-progress` are the two the rank legitimately steps over — nobody can act on
  # either and no person is being asked for anything. Everything else dispatches or stops.
  for id in $(all_ids); do
    row="$(row_for "$id")"
    rnext="$(field "$row" "$NEXT")"
    rstatus="$(field "$row" "$STATUS")"
    if [ "$rstatus" = "in-progress" ]; then
      printf 'NOTE      %s is in-progress — another session holds it; stepping over it\n' "$id"
      continue
    fi
    rblockers="$(open_blockers_of "$id")"
    if [ -n "$rblockers" ]; then
      printf 'NOTE      %s is blocked by %s— stepping over it\n' "$id" "$rblockers"
      continue
    fi
    # The column said `ready` and the item says otherwise. Unfixed, a driver dispatches an
    # unattended second session onto a ticket somebody is building — the worse instance of 0140,
    # because nobody reads the line it would have printed.
    if rhold="$(held_by "$id")"; then
      printf 'NOTE      %s is held by %s — another session holds it; stepping over it\n' "$id" "$rhold"
      continue
    fi
    if [ "$rstatus" = "waiting" ]; then
      decide "$ESCALATE" "ESCALATE  $id is waiting on a person and outranks everything below it
          $(waiting_on "$(item_for "$id")")"
    fi
    case "$rnext" in
      design)
        decide "$ESCALATE" "ESCALATE  $id is at next: design and outranks everything below it — a person decides
          $(design_question "$(item_for "$id")")" ;;
      queue)
        decide "$ESCALATE" "ESCALATE  $id is at next: queue — it has no acceptance criteria to build against, and specifying it is a person's call" ;;
      verify)
        PROPOSE_STAGE="verify"; PROPOSE_IDS="$id"
        decide "$DISPATCH" "DISPATCH  verify $id" ;;
      develop)
        # Finish before start (0131). Checked here, where a NEW gate would be formed, for the same
        # reason `findings_gate` is and just ahead of it: a ticket this run already built is
        # finished rather than left half-done while the run opens more work. Checked at the gate
        # rather than before the walk, so it preempts nothing a person is being asked to decide —
        # a `waiting`, `design` or `queue` row above this one still stops the run.
        if sv="$(started_verify)"; then
          PROPOSE_STAGE="verify"; PROPOSE_IDS="$sv"
          decide "$DISPATCH" "DISPATCH  verify $sv"
        fi
        gate="$(gate_from "$id" "$(takeable_develop)")"
        PROPOSE_STAGE="develop"; PROPOSE_IDS="$gate"
        findings_gate
        decide "$DISPATCH" "DISPATCH  develop $gate" ;;
      *)
        decide "$ESCALATE" "ESCALATE  $id is at next: '$rnext', which no routing rule covers — stopping rather than falling through to a default" ;;
    esac
  done
  decide "$RUN_COMPLETE" "COMPLETE  nothing takeable at develop — every row is done, blocked, or held by another session"
fi

# --- ./next <stage> ---------------------------------------------------------------------------
if [ -n "${1:-}" ]; then
  stage="$1"
  case "$stage" in
    queue|design|develop|verify) : ;;
    *) echo "unknown stage: $stage" >&2; usage >&2; exit 2 ;;
  esac

  took=0
  collided=0
  for id in $(ids_where "$NEXT" "$stage"); do
    row="$(row_for "$id")"
    written="$(field "$row" "$STATUS")"
    # `ready` and `blocked` are both candidates, because `blocked` is derived and the column only
    # caches it. Trusting the cache is the asymmetric half of the defect: a stale `blocked` hides
    # takeable work and no reader ever notices, where a stale `ready` is caught one line below.
    # `waiting` and `in-progress` are the two a person and a stage write directly, so a row at
    # either is skipped here as before. Neither is the ownership test: that is the item's, checked
    # below, and a row can read `ready` over a ticket somebody holds (0140).
    case "$written" in
      ready|blocked) : ;;
      *) continue ;;
    esac
    ob="$(open_blockers_of "$id")"
    if [ -n "$ob" ]; then
      printf 'SKIP      %s | blocked_by still open: %s\n' "$id" "$ob"
      continue
    fi
    # After the blocker check and before the stale-`blocked` line, so a held row is one line and
    # the open blocker keeps precedence — a row that is both is not takeable for either reason, and
    # the blocker is the one that outlives the claim. CONTINUE for the same reason the collision
    # branch carries: a session correctly warned and still with nothing to do is the same outcome
    # by a slower route.
    if hold="$(held_by "$id")"; then
      printf 'SKIP      %s | held by %s — the item carries a claim (references/CONCURRENCY.md,\n' "$id" "$hold"
      printf '                   *A stage writes only the ticket it holds*); the Status column is a cache of it\n'
      continue
    fi
    if [ "$written" = "blocked" ]; then
      printf 'DRIFT     %s | column says blocked, no blocked_by entry is still open\n' "$id"
    fi
    it="$(item_for "$id")"
    exp="$(fm_list "$it" expects)"
    # The proof used to be printed four lines below the verdict it contradicts: this loop filtered
    # on stage, `blocked_by` and the column, `show_claimed` ran afterward and independently, and
    # neither consulted the other. Cross them here, before the word TAKE is written.
    #
    # And CONTINUE rather than break — that is the load-bearing half. Suppressing the wrong TAKE
    # without it leaves a session correctly warned and still with nothing to do, which is the same
    # outcome by a slower route; the thing `develop` Step 1 actually asks for is the next clear row.
    clash="$(collision_report "$id" "$exp")"
    if [ -n "$clash" ]; then
      printf '%s\n' "$clash"
      collided=1
      continue
    fi
    # `close_by` is printed unconditionally, ABSENT OR NOT, rather than only when it is `develop`.
    # It decides whether the develop session closes the ticket itself or hands it to a QA pass, so a
    # session reading this line has to be able to tell "the default" from "the field was never
    # read" — and a conditional print makes the commonest branch the one no case can assert on
    # (0086 AC8).
    take_close_by="$(fm "$it" close_by)"
    [ -n "$take_close_by" ] || take_close_by=verify
    printf 'TAKE      %s | %s | size %s | qa %s | close %s\n' \
      "$id" "$(field "$row" "$TITLE")" "$(fm "$it" size)" "$(fm "$it" qa_level)" "$take_close_by"
    printf 'EXPECTS   %s\n' "${exp:-not predicted — check this one by hand}"
    took=1
    break
  done
  # Three outcomes, not two. An empty stage is not an error; a session asking "anything for me?"
  # gets a plain no and a zero. But a stage whose every row is held says something else entirely —
  # come back, or ask — and one message for both reads as "this stage is done" when it is not.
  if [ "$took" -eq 0 ]; then
    if [ "$collided" -eq 1 ]; then
      printf 'every takeable %s row collides with files another session holds — nothing here is safe to take\n' "$stage"
    else
      printf 'nothing is takeable at stage %s\n' "$stage"
    fi
  fi
  show_claimed
  warn_dirty
  exit 0
fi

# --- ./next (no argument) ---------------------------------------------------------------------
printf 'BY STAGE:  '
for s in queue design develop verify; do
  printf '%s %s  ' "$s" "$(rows | awk -F'|' -v n="$NEXT" -v w="$s" '{ v=$n; gsub(/^ +| +$/,"",v); if (v==w) c++ } END { print c+0 }')"
done
printf '\n'
printf 'BY STATUS: '
for s in ready waiting blocked in-progress; do
  printf '%s %s  ' "$s" "$(rows | awk -F'|' -v n="$STATUS" -v w="$s" '{ v=$n; gsub(/^ +| +$/,"",v); if (v==w) c++ } END { print c+0 }')"
done
printf '\n'
printf 'ROWS:      %s\n' "$(rows | wc -l | tr -d ' ')"
printf 'ROW 1:     %s | %s | %s | %s\n' \
  "$(field "$(rows | head -1)" "$ID")" "$(field "$(rows | head -1)" "$TITLE")" \
  "$(field "$(rows | head -1)" "$NEXT")" "$(field "$(rows | head -1)" "$STATUS")"
show_claimed
warn_dirty
