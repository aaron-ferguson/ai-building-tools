#!/bin/sh
#
# Close a backlog row: lock → re-read → tick the ACs → move the row to DONE.md → reconcile the rows
# this ticket was blocking → commit → unlock, as one atomic step.
#
# **The commit is why this is a script**, the same reason as `claim`: a close edits QUEUE.md and
# DONE.md, and until something commits those edits they sit dirty in the tree both windows share, so
# the next window to commit either carries the close off under its own message. A session under load
# forgets the commit; a script cannot.
#
# Usage:  .claude/backlog/close <id> <token>
#
# The token is not optional and is not minted here. `claim` mints it; `close` must be *given* it,
# because there is no ambient session id and the ownership test is memory — a ticket is yours only
# if you minted its token in this conversation. A script cannot check memory, so the argument is how
# the session proves it. A wrong token must fail loudly rather than close someone else's ticket.
#
# **Columns are resolved by header name, never by position** — the table's shape is not a contract,
# and a fixed-index parser is exactly the defect 0022 found in `claim`.
#
# **It refuses rather than guesses, on five grounds**: a row that is not at `verify`; a table shape
# it cannot read; a token that is not the one the item records; and an acceptance-criteria list it
# cannot tick. The fourth is the quietest — `verify` closes on ticked ACs, so a ticket whose
# criteria are written `- **AC1** —` rather than `- [ ] AC1 —` had zero of eight ticked, was
# closed, and reported success in the same words as a real close (0044).
#
# **The fifth ground is the light tier's whole gate (0086).** `verify` owns closing, and the one
# exception is an item recording `close_by: develop` — a ticket the session that BUILT it may close,
# paying no second session's startup floor. That is safe only where there is no belief to be wrong
# about, so the field is honoured only when every acceptance criterion NAMES A COMMITTED ASSERTION
# on its own line. Absent means `verify`, so every item written before this and every project not
# using the tier keeps its present behaviour with no edit.
#
# WHAT THIS SCRIPT CANNOT SEE, and it is the trade-off the tier accepted rather than an oversight:
# it checks that each light criterion CITES a guard git tracks. It cannot check that the guard CAN
# FAIL — `testing-conventions.md`, *a guard only ever seen passing is indistinguishable from one
# wired to nothing*. The residual risk is the builder's own recorded red, weaker than an
# independent read on purpose, and kept narrow by the eligibility rule alone. So the citation check
# FAILS CLOSED at every edge: an untracked path is not a citation, a repo git cannot read admits no
# light close, and a light ticket with NO criteria at all is refused rather than closed vacuously.
#
# **The reconcile is part of the close, not a follow-up.** `blocked` is derived from the graph, so
# closing this ticket is the only event that can clear a row naming it in `blocked_by`. Leaving them
# is a queue that lies about what is takeable, which once cost a whole session.
#
# See references/CONCURRENCY.md — 'The four scripts' and 'Lock every write to the backlog directory'.

set -eu

DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
QUEUE="$DIR/QUEUE.md"
DONE="$DIR/DONE.md"
LOCK="$DIR/.lock"

# `git-conventions.md` *Co-authorship* asks for this trailer on ALL AI-assisted commits, and a
# lifecycle commit a script makes on a session's behalf is one — skills/develop/SKILL.md Step 1
# says so in as many words: "A lifecycle commit is not exempt from it", and
# references/CONCURRENCY.md *The git index is shared* requires it of every AI-assisted commit. Those
# two files SETTLE the scope question; it is not open, and a third session need not re-ask it. It
# read as open only because Step 1's sentence sits inside its BY-HAND claim sequence, which a
# session running this script never executes (0090 FR4). The generic name is deliberate: the script
# cannot know which model is driving it, and guessing wrong is worse than the convention's own
# literal.
COAUTHOR="Co-Authored-By: Claude <noreply@anthropic.com>"

ID="${1:-}"
TOKEN="${2:-}"
[ -n "$ID" ] && [ -n "$TOKEN" ] || {
  echo "usage: close <id> <token>" >&2
  echo "the token is the item's claimed_by: — a close is only yours if you hold the claim" >&2
  exit 2
}
[ -f "$QUEUE" ] || { echo "no QUEUE.md at $QUEUE" >&2; exit 1; }
[ -f "$DONE" ]  || { echo "no DONE.md at $DONE — nowhere to move the row to" >&2; exit 1; }

TODAY="$(date -u +%Y-%m-%d)"

# Anything already dirty in the two shared files would ride along on our commit, so REFUSE rather
# than warn and carry on (0090 FR3). A pathspec limits a commit to the paths it names and never to
# authorship (`CONCURRENCY.md`, *A pathspec is necessary but not sufficient*), so there is no form of
# the commit below that can leave a foreign row behind — the only fix is upstream, and a script can
# refuse where a person under load cannot. Same argument and same shape as `claim` (0082 FR3): the
# rule was never specific to claiming.
#
# **Before the lock, deliberately.** A refusal that has taken the lock has something to undo; here
# "nothing was changed and no lock was taken" is true by construction.
#
# **Pathspecs here are relative to `$DIR`, deliberately — do not "tidy" them back to `$QUEUE`/`$DONE`.**
# Those are absolute, and on a case-insensitive filesystem `$DIR` can spell the repo path in a
# different case from `git rev-parse --show-toplevel` (both spellings of this repo are live). An
# absolute pathspec in the other case reads as *outside the repo*, and `git diff -- <a> <b>` then
# stops being "are these two files dirty?" and silently becomes a two-file comparison of QUEUE.md
# against DONE.md — printing every row as changed, which reads as another session having rewritten
# both shared files wholesale. That was a warning that cried wolf; now it is a refusal that blocks a
# legitimate close, so getting these two pathspecs right matters more than it did, not less.
if git -C "$DIR" rev-parse --git-dir >/dev/null 2>&1 && ! git -C "$DIR" diff --quiet -- QUEUE.md DONE.md; then
  echo "refusing to close $ID: QUEUE.md/DONE.md hold uncommitted changes this close's commit would carry" >&2
  echo "the rows that would land under 'Close $ID [$TOKEN]':" >&2
  git -C "$DIR" diff -U0 -- QUEUE.md DONE.md | awk '/^[+-]\| / { print "  " $0 }' >&2
  echo "commit them by pathspec if they are yours; if they are another session's, leave them alone" >&2
  echo "and wait, or 'git restore -- .claude/backlog/QUEUE.md .claude/backlog/DONE.md' if stray" >&2
  echo "nothing was changed and no lock was taken" >&2
  exit 1
fi

# --- lock -------------------------------------------------------------------------------------
mkdir "$LOCK" 2>/dev/null || {
  echo "backlog is locked by: $(cat "$LOCK/held-by" 2>/dev/null || echo unknown)" >&2
  exit 1
}
printf 'close %s by %s\n%s\n' "$ID" "$TOKEN" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$LOCK/held-by"
# Release however we leave, so a failed close never strands the other window.
trap 'rm -rf "$LOCK"' EXIT INT TERM

# --- resolve the columns by name, under the lock ----------------------------------------------
header_of() {
  awk -F'|' '/^\|/ {
    for (i = 2; i < NF; i++) { v = $i; gsub(/^ +| +$/, "", v); if (v == "ID") { print; exit } }
  }' "$1"
}
column_in() {
  printf '%s' "$1" | awk -F'|' -v want="$2" '{
    for (i = 2; i < NF; i++) { v = $i; gsub(/^ +| +$/, "", v); if (v == want) { print i; exit } }
  }'
}

QHEAD="$(header_of "$QUEUE")"
[ -n "$QHEAD" ] || { echo "no table header in $QUEUE — expected a row with an 'ID' cell" >&2; exit 1; }

missing=""
for want in ID Title Next Status; do
  [ -n "$(column_in "$QHEAD" "$want")" ] || missing="$missing $want"
done
[ -z "$missing" ] || {
  echo "QUEUE.md's table is missing the column(s):$missing" >&2
  echo "header found: $QHEAD" >&2
  echo "a shape this script cannot read is an error, never a refusal that looks like a closed ticket" >&2
  exit 1
}

Q_ID="$(column_in "$QHEAD" ID)"
Q_TITLE="$(column_in "$QHEAD" Title)"
Q_NEXT="$(column_in "$QHEAD" Next)"
Q_STATUS="$(column_in "$QHEAD" Status)"

read_cell() { printf '%s' "$1" | awk -F'|' -v c="$2" '{ v = $c; gsub(/^ +| +$/, "", v); print v }'; }

# --- re-read the row under the lock -----------------------------------------------------------
row="$(awk -F'|' -v id="$ID" -v c="$Q_ID" '/^\|/ { v = $c; gsub(/^ +| +$/, "", v); if (v == id) { print; exit } }' "$QUEUE")"
[ -n "$row" ] || { echo "no row for $ID in QUEUE.md" >&2; exit 1; }

next_field="$(read_cell "$row" "$Q_NEXT")"
title="$(read_cell "$row" "$Q_TITLE")"
# The stage check is DELIBERATELY not here any more: which stages may close depends on the item's
# `close_by:`, and the item is resolved below. It runs at 'the stage check' further down.

# --- the ownership test -----------------------------------------------------------------------
item="$(ls "$DIR/items/$ID-"*.md 2>/dev/null | head -1 || true)"
[ -n "$item" ] || { echo "no item file for $ID" >&2; exit 1; }
item_rel="items/$(basename "$item")"

# YAML's comment rule, as awk source text injected into both readers below. awk has no include, so
# a shared implementation is a string rather than a file; `next` and `handoff` carry this same block
# for their own readers, and the scripts are separate files by install contract
# (`tests/backlog-scripts-installed.test.sh` AC2). Change one, change all three.
#
# It applies to SCALARS as much as to lists: `develop` Step 1 invites an inline annotation, and an
# annotated `claimed_by: "f0c3" # mine` used to come back as `f0c3" # mine` — which this script then
# compares against the token it was given, refusing the holder's own close (0044).
#
# `sub(/#.*/, "")` is the obvious form and it is wrong twice, so do not simplify it back:
#   - `- "docs/a#b.md"` is a legal quoted path, and the naive form truncates it to `docs/a`;
#   - in YAML a `#` only opens a comment at the start of a value or after whitespace, so `a#b`
#     unquoted is one token too.
# `"\047"` is an apostrophe — this block is single-quoted shell.
DECOMMENT='
function decomment(s,   i, ch, quote, out, start) {
  sub(/^[ \t]+/, "", s)
  start = 1
  ch = substr(s, 1, 1)
  if (ch == "\"" || ch == "\047") { quote = ch; start = 2 }
  for (i = start; i <= length(s); i++) {
    ch = substr(s, i, 1)
    if (quote != "" && ch == quote) { quote = ""; continue }
    if (quote != "")                { out = out ch; continue }
    if (ch == "#" && (i == start || substr(s, i - 1, 1) ~ /[ \t]/)) break
    out = out ch
  }
  sub(/[ \t]+$/, "", out)
  return out
}
'

fm_value() {
  awk -v key="$2" "$DECOMMENT"'
    NR == 1 && /^---$/ { fm = 1; next }
    fm && /^---$/      { exit }
    fm && index($0, key ":") == 1 {
      print decomment(substr($0, length(key) + 2)); exit
    }
  ' "$1"
}

# One frontmatter LIST, flattened to a space-separated line: inline `["0010"]` or a block of `- `
# entries. `fm_value` returns only what sits after the colon on the key's own line, so it read the
# block form as empty — the reconcile's `case` missed, and closing 0028 left 0029 blocked in both
# the item and the row while reporting no reconcile at all. `next` has read both forms since 0031;
# this is that parser, so the two scripts answer "what blocks this?" identically (0044 FR1).
fm_list() {
  [ -n "$1" ] || return 0
  awk -v key="$2" "$DECOMMENT"'
    NR == 1 && /^---$/ { fm = 1; next }
    fm && /^---$/ { exit }
    fm && $0 ~ "^" key ":" {
      rest = $0; sub("^" key ": *", "", rest)
      rest = decomment(rest)
      if (rest ~ /\[/) { gsub(/[][",]/, " ", rest); printf "%s", rest; exit }
      inside = 1; next
    }
    # A comment on its own line is skipped rather than ending the block: falling through to the
    # `exit` below would silently truncate the list at the note.
    inside && /^[ \t]*#/ { next }
    inside && /^  *- / {
      sub(/^ *- */, "")
      entry = decomment($0)
      if (entry != "") printf "%s ", entry
      next
    }
    inside { exit }
  ' "$1"
}

held_by="$(fm_value "$item" claimed_by)"
[ -n "$held_by" ] || {
  echo "$ID records no claimed_by: — nothing holds it, so there is no claim to close under" >&2
  echo "claim it first: ./claim $ID" >&2
  exit 1
}
[ "$held_by" = "$TOKEN" ] || {
  echo "$ID is held by token '$held_by', not '$TOKEN' — refusing to close another session's ticket" >&2
  echo "a ticket is yours only if you minted its token in this conversation; ask, never take over" >&2
  exit 1
}


# --- the declared scope against what the commits actually changed (0106 FR3) -------------------
# `touches:` can name a file for an edit that never happens, and nothing notices: 0039's re-entry
# declared `.claude-plugin/plugin.json` for a version bump that never occurred. An unused
# reservation is invisible by construction — `./next --drift` compares Status against `blocked_by`,
# and until this nothing compared the declared scope against the diff.
#
# **A NOTE, never a gate.** Over-declaring is legitimate — you widen `touches:` before you know how
# far the work reaches — so a mismatch is not an error. The asymmetry is the point: a touch reaching
# FURTHER than declared is the dangerous one, and one reaching LESS far carries an intention that
# reads, to the next session, as a completed step. Both are printed; neither refuses.
#
# The range is anchored to the CLAIM COMMIT for this token. It is the only marker in the history
# that says "this session's work starts here", and `claim` writes it. No such commit — a by-hand
# claim, a fixture, a backlog that predates the script — means no range, and no range means no
# report rather than a report over an invented one.
#
# The backlog's own bookkeeping is excluded: QUEUE.md, DONE.md, FINDINGS.md and the item file are
# written by these scripts on every ticket and are declared by none, so reporting them would put a
# guaranteed false positive on every close and teach the reader to skip the whole note.
#
# **This block is duplicated verbatim in `close` and `handoff`** — the two stages that release a
# claim, and so the two that can compare the field before it is cleared. A backlog script is a
# separate file by install contract (`tests/backlog-scripts-installed.test.sh`) and sources
# nothing, so a shared implementation is a copy. Change one, change both.
SCOPE_NOTE=""

# The `touches:` entries, decommented. `#` opens a comment only at the start of a value or after
# whitespace, which is YAML's own rule and the reason `sub(/#.*/, "")` is wrong: `- docs/a#b.md` is
# one token. A standalone comment LINE inside the block is skipped rather than ending it —
# `develop` Step 1 invites exactly that annotation, and truncating at it reads a narrowed-and-
# annotated scope as empty.
declared_touches() {
  awk '
    NR == 1 && /^---$/ { fm = 1; next }
    fm && /^---$/      { exit }
    fm && /^touches:/  { intou = 1; next }
    intou && /^[ \t]*$/ { next }
    intou && /^[ \t]*#/ { next }
    intou && /^[ \t]*- / {
      sub(/^[ \t]*- */, "")
      sub(/[ \t]+#.*$/, "")
      sub(/[ \t]+$/, "")
      if ($0 != "") print
      next
    }
    intou { exit }
  ' "$1"
}

scope_note() {
  git -C "$DIR" rev-parse --git-dir >/dev/null 2>&1 || return 0
  git -C "$DIR" rev-parse -q --verify HEAD >/dev/null 2>&1 || return 0

  declared="$(declared_touches "$item")"
  [ -n "$declared" ] || return 0

  # Oldest first: a token can appear on several commits, and the claim is the first of them.
  claim_sha="$(git -C "$DIR" log --format='%H %s' | grep -F "[$TOKEN]" | tail -1 | cut -d' ' -f1)"
  [ -n "$claim_sha" ] || return 0

  # `A^..HEAD` includes A itself. On a root commit there is no `A^`, and `--root` is what makes
  # `--name-only` report a root commit's paths at all rather than silently listing none.
  if git -C "$DIR" rev-parse -q --verify "$claim_sha^" >/dev/null 2>&1; then
    range="$claim_sha^..HEAD"
  else
    range="HEAD"
  fi
  actual="$(git -C "$DIR" log --root --format= --name-only "$range" | grep . | sort -u || true)"

  prefix="$(git -C "$DIR" rev-parse --show-prefix)"
  bookkeeping="${prefix}QUEUE.md ${prefix}DONE.md ${prefix}FINDINGS.md ${prefix}items/$(basename "$item")"

  # A declared entry covers a path that IS it, or that sits under it — so declaring a directory
  # reads as declaring what is in it, which is how sessions actually write the field.
  covers() {
    for d in $2; do
      [ "$1" = "$d" ] && return 0
      case "$1" in "$d"/*) return 0 ;; esac
    done
    return 1
  }

  undeclared=""
  for p in $actual; do
    case " $bookkeeping " in *" $p "*) continue ;; esac
    covers "$p" "$declared" || undeclared="$undeclared $p"
  done

  untouched=""
  for d in $declared; do
    hit=0
    for p in $actual; do
      [ "$p" = "$d" ] && { hit=1; break; }
      case "$p" in "$d"/*) hit=1; break ;; esac
    done
    [ "$hit" -eq 1 ] || untouched="$untouched $d"
  done

  if [ -z "$undeclared" ] && [ -z "$untouched" ]; then
    SCOPE_NOTE="scope: touches: and the commits since the claim agree"
    return 0
  fi
  [ -z "$untouched" ]  || SCOPE_NOTE="scope: declared but untouched:$untouched"
  [ -z "$undeclared" ] || SCOPE_NOTE="${SCOPE_NOTE:+$SCOPE_NOTE
}scope: touched but undeclared:$undeclared"
  SCOPE_NOTE="$SCOPE_NOTE
scope: a note, not a gate — widen or narrow the field on the next ticket, never this one"
  return 0
}
scope_note

item_type="$(fm_value "$item" type)"
item_qa="$(fm_value "$item" qa_level)"

# --- who may close this row (0086) ------------------------------------------------------------
# ABSENT MEANS `verify`. That default is the whole migration story: no existing item and no other
# project needs an edit, and it must never be inverted to "absent means develop" — a fail-open
# here closes every unopted ticket from the stage that built it.
close_by="$(fm_value "$item" close_by)"
[ -n "$close_by" ] || close_by=verify
case "$close_by" in
  verify|develop) : ;;
  *)
    echo "$ID records close_by: '$close_by', which is neither 'verify' nor 'develop'" >&2
    echo "an unreadable value is an error, never a fail-open: guessing here would either close a" >&2
    echo "ticket nobody meant to be light, or refuse one that is. Fix the item's frontmatter" >&2
    exit 1
    ;;
esac

# FR12 — the ONE interaction between the two fields, made mechanical rather than left to be
# inferred from FR3. `qa_level: review` means the checks are a reader's judgement; `close_by:
# develop` admits only executed assertions. Checked TOGETHER, because each field is individually
# legitimate and it is the pair that cannot hold.
if [ "$close_by" = develop ] && [ "$item_qa" = review ]; then
  echo "$ID carries qa_level: review with close_by: develop, and those cannot hold together" >&2
  echo "a review's checks are a reader's judgement; the light tier admits only a committed" >&2
  echo "assertion that returns the same answer in either session. Hand it to verify, or drop the" >&2
  echo "review level if every criterion really is scripted" >&2
  exit 1
fi

# --- the stage check --------------------------------------------------------------------------
# FR6 reads "a row whose `next` is not `verify` is refused unless its item records `close_by:
# develop`". Taken literally that admits a `next: design` row, which no FR wants — FR2 names the
# session that BUILT it. So `close_by: develop` admits `develop` and nothing else, and the case
# below is asserted (tests/close.test.sh, 0086 FR6) because the literal reading is the one a later
# edit would restore.
if [ "$close_by" = develop ]; then
  closable_stage=develop
else
  closable_stage=verify
fi
[ "$next_field" = "$closable_stage" ] || {
  echo "$ID is at stage '$next_field', not '$closable_stage' — only a verified ticket is closable" >&2
  if [ "$close_by" = develop ]; then
    echo "this item records close_by: develop, so the stage that may close it is 'develop' — the" >&2
    echo "session that built it. No other stage closes a row, opted in or not" >&2
  else
    echo "verify owns closing, and it holds the verdict when it acts; nothing else may close a row" >&2
  fi
  exit 1
}

# --- the fourth refusal: criteria this script cannot tick --------------------------------------
# Counted BEFORE anything is written, so the refusal leaves the tree exactly as it found it. An
# EMPTY criteria section is not this defect and still closes: nothing to tick is not the same as
# criteria that cannot be ticked, and refusing there would block every chore written without ACs.
#
# The marker class is EVERY list form, not `- ` alone. Counting only `- ` let a `1.`/`2.`/`3.`
# list score zero bullets and fall through to the empty-section allowance below, so `close`
# reported success having ticked none of them — the exact defect this refusal exists to stop,
# through a door it did not cover. Six items were captured in that form, three at `next: verify`.
#
# `content` is what separates ABSENT from UNREADABLE. A section with no marker of any kind but
# real lines in it is criteria written in a shape this script cannot parse, which is the defect;
# a section with nothing in it is a chore with no ACs, which is not. The old counter conflated
# them because zero bullets was the only signal it had.
ac_counts="$(awk '
  /^## / { in_ac = ($0 ~ /^## Acceptance criteria/); next }
  in_ac {
    if ($0 ~ /^[ \t]*$/) next
    content++
    if ($0 ~ /^([-*+]|[0-9]+[.)])[ \t]/) { bullets++; if ($0 ~ /^- \[[ xX]\]/) boxes++ }
  }
  END { print bullets + 0, boxes + 0, content + 0 }
' "$item")"
read -r ac_bullets ac_boxes ac_content <<AC_EOF
$ac_counts
AC_EOF

if [ "$ac_bullets" -gt 0 ] && [ "$ac_boxes" -eq 0 ]; then
  echo "$ID lists $ac_bullets acceptance criteria and not one of them is a checkbox" >&2
  echo "this script ticks '- [ ] AC1 — …' and nothing else, so closing here would record that none" >&2
  echo "of the $ac_bullets was checked — and DONE.md could not tell this ticket from one waved through" >&2
  echo "rewrite the criteria in the '- [ ]' form (skills/queue/templates/item.md) and close again" >&2
  exit 1
fi

if [ "$ac_bullets" -eq 0 ] && [ "$ac_content" -gt 0 ]; then
  echo "$ID has $ac_content lines under 'Acceptance criteria' and not one list marker among them" >&2
  echo "this script ticks '- [ ] AC1 — …' and nothing else, so it cannot tell whether these lines" >&2
  echo "are criteria it failed to parse or prose that belongs elsewhere — and an empty section is" >&2
  echo "the one case that closes, so guessing here would record an unchecked ticket as a clean one" >&2
  echo "rewrite the criteria in the '- [ ]' form (skills/queue/templates/item.md) and close again" >&2
  exit 1
fi

# --- the fifth refusal: a light ticket whose criteria are not assertions (0086) ----------------
# Counted BEFORE anything is written, like the fourth, so the refusal leaves the tree exactly as it
# found it.
#
# WHY EACH BULLET AND NOT THE SECTION. FR3 admits a light close only where EVERY criterion is
# discharged by a committed assertion, so a check answering "does this section mention a guard
# anywhere?" is green on a ticket where one criterion is an eyeball and the rest are scripted —
# which is precisely the ticket the tier must refuse. The message names the criterion, so the
# refusal is actionable rather than a status (`testing-conventions.md`, assert the message).
if [ "$close_by" = develop ]; then
  # A cited path is a backtick-quoted token containing `/`. Continuation lines are folded into
  # their bullet first: this repo's criteria wrap over three or four lines and a line-based reader
  # would judge each fragment separately, refusing the wrapped half of a perfectly cited criterion.
  ac_lines="$(awk '
    function emit(  txt, n, i, parts, toks) {
      txt = cur
      sub(/^- \[[ xX]\][ \t]*/, "", txt)
      gsub(/[ \t]+/, " ", txt)
      n = split(cur, parts, "`")
      toks = ""
      # Odd indices are OUTSIDE the backticks, even ones inside. A bare path in prose is
      # deliberately not a citation: the code span is what distinguishes a named file from a
      # sentence mentioning a directory.
      for (i = 2; i <= n; i += 2) if (index(parts[i], "/") > 0) toks = toks " " parts[i]
      printf "%s\t%s\t%s\n", ln, substr(txt, 1, 64), toks
      cur = ""
    }
    /^## / { if (cur != "") emit(); in_ac = ($0 ~ /^## Acceptance criteria/); next }
    !in_ac { next }
    /^- \[[ xX]\]/ { if (cur != "") emit(); cur = $0; ln = NR; next }
    cur != "" && $0 ~ /^[ \t]*$/ { emit(); next }
    cur != "" { cur = cur " " $0; next }
    END { if (cur != "") emit() }
  ' "$item")"

  # A light ticket with NO criteria at all is refused, where a `verify` one still closes. The
  # empty-section allowance above exists for a chore nobody wrote ACs for; on a light ticket it
  # would close a self-certified row having checked nothing, which is exactly the "self-attested"
  # option 0086 rejected. "Every criterion is an assertion" is vacuously true of none, and that is
  # the reading to refuse, not to honour.
  if [ -z "$ac_lines" ]; then
    echo "$ID records close_by: develop and lists no acceptance criteria this script can read" >&2
    echo "the light tier is earned by criteria that are executed assertions, so a ticket with none" >&2
    echo "would close self-certified having checked nothing — which is the tier that was rejected" >&2
    echo "either write criteria in the '- [ ] AC1 — …' form citing their guards, or hand it to verify" >&2
    exit 1
  fi

  # `git` is required here, not optional. A repo git cannot read proves no path is committed, and
  # "committed" is the half of FR3 a plain file test cannot see — so this fails closed rather than
  # degrading to an existence check nobody asked for.
  git -C "$DIR" rev-parse --git-dir >/dev/null 2>&1 || {
    echo "$ID records close_by: develop, and $DIR is not in a git repository" >&2
    echo "the light tier's gate is that every criterion cites a COMMITTED assertion, which cannot" >&2
    echo "be established here. Hand it to verify" >&2
    exit 1
  }

  # One question, one function, and it keeps the loop below two levels deep rather than four
  # (`coding-conventions.md`, Review Checklist — nesting, and one thing per function).
  # `:/` makes the pathspec repo-root-relative whatever the cwd is, so this needs no
  # `--show-toplevel` — see the case-spelling warning at the top of this file.
  token_committed() {
    git -C "$DIR" ls-files --error-unmatch -- ":/$1" >/dev/null 2>&1
  }

  # A CITATION HAS TO NAME AN ASSERTION, NOT MERELY A TRACKED FILE. FR3 admits a light close only
  # where every criterion is discharged by a "committed automated assertion", and the first
  # implementation checked two of those three words — backticked, tracked. A fixture whose two
  # criteria cited a tracked `docs/notes.md` closed on exit 0 with nothing executed anywhere
  # (verified 2026-09-08), which is option 3, the self-attested tier 0086 rejected, reachable in
  # one wrong citation.
  #
  # This script cannot know what an arbitrary file DOES, so it reads the two signals it can, and
  # either one is enough. Both routes exist because either alone refuses a legitimate guard: a
  # shell suite lives at `tests/x.test.sh` and is executable, a JS or Python suite is committed at
  # mode 100644 and named by convention, and a repo-specific check can be an executable at a path
  # no convention predicts. What neither route admits is a document.
  #
  # A guard at a path this cannot recognise is not a defect to route around: name it
  # conventionally, or hand the ticket to `verify`, which is what the refusal below says.
  path_is_conventional_guard() {
    case "$1" in
      tests/*|test/*|spec/*|specs/*|__tests__/*)             return 0 ;;
      */tests/*|*/test/*|*/spec/*|*/specs/*|*/__tests__/*)   return 0 ;;
      *.test.*|*_test.*|*.spec.*|*_spec.*)                   return 0 ;;
      */test_*|*/spec_*)                                     return 0 ;;
    esac
    return 1
  }

  # The INDEX's mode, never the working tree's: the gate's subject is what was committed, and a
  # `chmod +x` after the commit is not it. A directory citation lists every file under it, and one
  # executable among them is enough — a directory naming a suite is a citation of the suite.
  path_is_committed_executable() {
    git -C "$DIR" ls-files -s -- ":/$1" 2>/dev/null | grep -q '^100755 '
  }

  # Prints nothing when the criterion cites a guard; otherwise prints the reason it does not,
  # which goes verbatim into the refusal. The two reasons are worth telling apart: "no committed
  # path" is a guard that was never added, and "committed but not an assertion" is a citation
  # pointing at the wrong kind of file — different fixes, and the second is the one that used to
  # close.
  describe_citation_problem() {
    tracked=""
    for tok in $1; do
      token_committed "$tok" || continue
      tracked="$tracked $tok"
      path_is_conventional_guard "$tok"  && return 0
      path_is_committed_executable "$tok" && return 0
    done
    [ -z "$tracked" ] && { printf 'names no committed path'; return 0; }
    printf 'cites%s, which is committed but is not an assertion' "$tracked"
  }

  uncited=""
  TAB="$(printf '\t')"
  while IFS="$TAB" read -r ac_ln ac_txt ac_toks; do
    [ -n "$ac_ln" ] || continue
    problem="$(describe_citation_problem "$ac_toks")"
    [ -z "$problem" ] || uncited="$uncited
  line $ac_ln: $ac_txt
    ↳ $problem"
  done <<AC_CITE_EOF
$ac_lines
AC_CITE_EOF

  if [ -n "$uncited" ]; then
    echo "$ID records close_by: develop, and these criteria name no committed assertion:$uncited" >&2
    echo "" >&2
    echo "the light tier is closed by the session that built it, which is safe only where every" >&2
    echo "criterion's verdict is an executed assertion returning the same answer in either session" >&2
    echo "cite the guard in backticks on the criterion's own line — \`tests/thing.test.sh\` — and" >&2
    echo "commit it; a path git does not track is not evidence anything ran" >&2
    echo "a committed path counts as an assertion where it sits under a test/spec directory, is" >&2
    echo "named *.test.* / *_test.* / *.spec.*, or was committed executable. A document is not one" >&2
    echo "or raise the item to close_by: verify and hand it to an independent pass" >&2
    exit 1
  fi
fi

# --- the review checklist: performed, or not closable (0086 FR11) ------------------------------
# The same argument as the fourth refusal, applied to the section a `qa_level: review` pass fills
# in: a review declared and never performed closes with a full checklist, and DONE.md cannot tell
# it from a performed one. That is the guard-that-cannot-fail shape, and this is the ONE mechanical
# assertion standing behind the whole prose half of the review level — so it is unconditional, not
# gated on `qa_level`, because an unperformed checklist is the same defect at either tier.
#
# `rc_ticked` COUNTS `- [x]` AND NOTHING ELSE, and that is the whole point of the refusal. The
# first implementation counted `/^- \[[ xX]\]/` — a class containing a SPACE — so it measured
# whether checkbox SYNTAX was present rather than whether anything had been ticked, and three
# `- [ ]` lines closed the row with the review unperformed. Worse, the form that defeated it is the
# form every instruction produces: FR11, `verify` Step 2 and this script's own message below all
# tell a session to write `- [ ] …` boxes, so the only input the guard caught was the one nothing
# asks for (verified 2026-09-08, 0086 AC5 fixture; tests/close.test.sh, 0086 AC5).
#
# WHY THE AC COUNTER ABOVE IS DIFFERENT and must NOT be changed to match. `close` ticks the ACs
# itself, so an AC list arrives here legitimately unticked and `ac_boxes` asks only whether the
# bullets are in a form this script CAN tick. A checklist arrives already performed or not at all:
# nothing downstream ticks it, so presence of the box says nothing.
#
# A PARTLY ticked checklist closes, exactly as a partly ticked AC list does: a visible verdict is
# a reader's business, and refusing it would be stricter than FR11's "on the same grounds".
rc_counts="$(awk '
  /^## / { in_rc = ($0 ~ /^## Review checklist/); next }
  in_rc {
    if ($0 ~ /^[ \t]*$/) next
    content++
    if ($0 ~ /^([-*+]|[0-9]+[.)])[ \t]/) { bullets++; if ($0 ~ /^- \[[xX]\][ \t]/) ticked++ }
  }
  END { print bullets + 0, ticked + 0, content + 0 }
' "$item")"
read -r rc_bullets rc_ticked rc_content <<RC_EOF
$rc_counts
RC_EOF

if [ "$rc_bullets" -gt 0 ] && [ "$rc_ticked" -eq 0 ]; then
  echo "$ID lists $rc_bullets lines under 'Review checklist' and not one of them is ticked" >&2
  echo "a review is performed by reading each line and ticking it, so closing here would record" >&2
  echo "that none of the $rc_bullets was checked — and DONE.md could not tell this ticket from a" >&2
  echo "review that never happened. An empty box is the shape of an unperformed check, not of a" >&2
  echo "performed one: write each line as '- [ ] …' and tick what you read as '- [x] …'" >&2
  exit 1
fi

if [ "$rc_bullets" -eq 0 ] && [ "$rc_content" -gt 0 ]; then
  echo "$ID has $rc_content lines under 'Review checklist' and not one list marker among them" >&2
  echo "this script reads '- [ ] …' and nothing else, so it cannot tell whether these lines are a" >&2
  echo "checklist it failed to parse or prose that belongs elsewhere — and an empty section is the" >&2
  echo "one case that closes, so guessing here would record an unperformed review as a clean one" >&2
  exit 1
fi

# --- the item file: tick the ACs, mark it done, release the claim ------------------------------
# `touches:` is cleared with its list entries: a closed ticket that keeps reserving files reads as
# held to the other window (CONCURRENCY.md, 'The working tree is shared too').
tmp="$(mktemp)"
awk -v today="$TODAY" '
  NR == 1 && /^---$/ { fm = 1; print; next }
  fm && /^---$/ {
    if (!closed_seen) print "closed: " today
    fm = 0; print; next
  }
  fm {
    if ($0 ~ /^status:/)     { print "status: done"; next }
    # A done ticket is due at no stage. The by-hand closes that predate this script cleared it;
    # leaving `next: verify` on a `status: done` item is the field-and-status disagreement the
    # next/status split exists to prevent (0044 FR4).
    if ($0 ~ /^next:/)       { print "next:"; next }
    if ($0 ~ /^closed:/)     { print "closed: " today; closed_seen = 1; next }
    if ($0 ~ /^claimed_by:/) { print "claimed_by:"; next }
    if ($0 ~ /^claimed_at:/) { print "claimed_at:"; next }
    if ($0 ~ /^touches:/)    { print "touches:"; skiplist = 1; next }
    if (skiplist && $0 ~ /^[ \t]*- /) { next }
    skiplist = 0
    print; next
  }
  /^## / { in_ac = ($0 ~ /^## Acceptance criteria/) }
  in_ac && /^- \[ \]/ { sub(/^- \[ \]/, "- [x]") }
  { print }
' "$item" > "$tmp"
mv "$tmp" "$item"

# --- QUEUE.md: delete the row -----------------------------------------------------------------
tmp="$(mktemp)"
awk -F'|' -v id="$ID" -v c="$Q_ID" '
  /^\|/ { v = $c; gsub(/^ +| +$/, "", v); if (v == id) next }
  { print }
' "$QUEUE" > "$tmp"
mv "$tmp" "$QUEUE"

# --- DONE.md: prepend the row, by that table's own column names -------------------------------
# Built from the QUEUE row's title plus the item's frontmatter, so the two files cannot disagree
# about what a ticket was called.
DHEAD="$(header_of "$DONE")"
[ -n "$DHEAD" ] || { echo "no table header in $DONE — expected a row with an 'ID' cell" >&2; exit 1; }

done_row="$(printf '%s' "$DHEAD" | awk -F'|' \
  -v id="$ID" -v title="$title" -v type="$item_type" -v qa="$item_qa" -v today="$TODAY" -v rel="$item_rel" -v donefile="$DONE" '
  {
    out = "|"
    for (i = 2; i < NF; i++) {
      v = $i; gsub(/^ +| +$/, "", v)
      if      (v == "ID")     val = id
      else if (v == "Title")  val = title
      else if (v == "Type")   val = type
      else if (v == "QA")     val = qa
      # `Completed` and `Date` are this column as other projects spell it. An unrecognised
      # name still falls through to blank, because a `Notes` column is a human summary no script
      # can author — but it says so on stderr rather than silently dropping the cell, which is how
      # three closes in a row landed with a blank date and a blank summary in a file kept as a
      # historical record. Silence was the worst of the available options.
      else if (v == "Closed" || v == "Completed" || v == "Date") val = today
      else if (v == "Item")   val = "[" rel "](" rel ")"
      else                  { val = ""; blank = blank (blank ? ", " : "") v }
      out = out " " val " |"
    }
    if (blank != "") printf "note: %s: left blank (no value this script can author): %s\n", donefile, blank > "/dev/stderr"
    print out
  }')"

hdr_line="$(awk -v h="$DHEAD" '$0 == h { print NR; exit }' "$DONE")"
tmp="$(mktemp)"
awk -v at="$hdr_line" -v row="$done_row" 'NR == at + 1 { print; print row; next } { print }' "$DONE" > "$tmp"
mv "$tmp" "$DONE"

# --- reconcile the tickets this ticket was blocking --------------------------------------------
# Only dependents that are *currently blocked* and that nothing holds. Three guards, and the
# selection is deliberately not `blocked_by` alone: nothing clears `blocked_by` at close, so a
# closed ticket names its blockers for ever and selecting on it resurrects one.
# Every blocker other than the one being closed. A blocker with no item file counts as open:
# unrecognised is not the safe default, and freeing a row on a missing file is the wrong direction.
other_blockers_all_done() {
  for b in $1; do
    [ "$b" != "$ID" ] || continue
    bfile="$(ls "$DIR/items/$b-"*.md 2>/dev/null | head -1 || true)"
    [ -n "$bfile" ] && [ "$(fm_value "$bfile" status)" = "done" ] || return 1
  done
  return 0
}

FREED=""
SKIPPED=""
RECONCILED_PATHS=""
for dep in "$DIR"/items/*.md; do
  [ -f "$dep" ] || continue
  [ "$dep" != "$item" ] || continue
  blockers="$(fm_list "$dep" blocked_by)"
  # Whole ids, never a substring: `fm_list` flattens both forms to bare space-separated entries,
  # and `case "$blockers" in *"$ID"*` would read `0044` as naming `004`.
  names_this=no
  for b in $blockers; do
    if [ "$b" = "$ID" ]; then names_this=yes; break; fi
  done
  [ "$names_this" = yes ] || continue
  dep_id="$(fm_value "$dep" id)"
  [ -n "$dep_id" ] || continue
  other_blockers_all_done "$blockers" || continue

  # A person is needed → waiting, not ready. The section is the authority (`## Waiting on`).
  if grep -q '^## Waiting on' "$dep"; then new_status=waiting; else new_status=ready; fi

  dep_row="$(awk -F'|' -v id="$dep_id" -v c="$Q_ID" '/^\|/ { v = $c; gsub(/^ +| +$/, "", v); if (v == id) { print; exit } }' "$QUEUE")"

  # Held by someone → report it, never write it. `held` is defined in exactly one place —
  # CONCURRENCY.md, 'A stage writes only the ticket it holds' — and this guard implements that
  # definition with no condition of its own (0029). The row is deliberately not consulted: an
  # `in-progress` cell over a tokenless item is drift, which `./next --drift` reports, and reading
  # it as ownership here is the second definition that made the script stricter than the rule.
  if [ -n "$(fm_value "$dep" claimed_by)" ]; then
    SKIPPED="$SKIPPED $dep_id"
    continue
  fi

  # Not blocked → there is nothing to free, and writing anyway is how a `done` dependent comes
  # back to life. Silent: every ticket this one ever blocked and that has since closed lands
  # here, and that is the normal case, not an anomaly.
  [ "$(fm_value "$dep" status)" = "blocked" ] || continue

  tmp="$(mktemp)"
  awk -v s="$new_status" '
    NR == 1 && /^---$/ { fm = 1; print; next }
    fm && /^---$/      { fm = 0; print; next }
    fm && /^status:/   { print "status: " s; next }
    { print }
  ' "$dep" > "$tmp"
  mv "$tmp" "$dep"

  if [ -n "$dep_row" ]; then
    tmp="$(mktemp)"
    awk -F'|' -v OFS='|' -v id="$dep_id" -v idc="$Q_ID" -v c="$Q_STATUS" -v s="$new_status" '
      /^\|/ { v = $idc; gsub(/^ +| +$/, "", v); if (v == id) $c = " " s " " }
      { print }
    ' "$QUEUE" > "$tmp"
    mv "$tmp" "$QUEUE"
  fi

  FREED="$FREED $dep_id"
  RECONCILED_PATHS="$RECONCILED_PATHS $DIR/items/$(basename "$dep")"
done

# --- commit, by pathspec, in the same breath as the edits --------------------------------------
# An uncommittable repo is fatal here, not a skip: the commit is the entire reason this is a script,
# so a close that silently leaves both shared files dirty is the failure it exists to prevent.
git -C "$DIR" rev-parse --git-dir >/dev/null 2>&1 || {
  echo "not a git repository ($DIR) — QUEUE.md, DONE.md and the item are edited but uncommitted" >&2
  echo "commit them by pathspec yourself before anything else touches those files" >&2
  exit 1
}
# Retry briefly: the other window may hold .git/index.lock mid-commit. Never remove that lock.
n=0
# shellcheck disable=SC2086
until git -C "$DIR" commit -q -m "Close $ID [$TOKEN]" -m "$COAUTHOR" -- "$QUEUE" "$DONE" "$item" $RECONCILED_PATHS 2>/dev/null; do
  n=$((n + 1))
  [ "$n" -lt 30 ] || {
    echo "could not commit the close (git busy) — the files are edited but uncommitted" >&2
    exit 1
  }
done

echo "closed $ID — $title"
[ -z "$SCOPE_NOTE" ] || echo "$SCOPE_NOTE"
[ -z "$FREED" ]   || echo "reconciled (no longer blocked):$FREED"
[ -z "$SKIPPED" ] || echo "left alone, held by another session:$SKIPPED"
